<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OsuPlayer.Avalonia.ViewModels"
             x:Class="OsuPlayer.Avalonia.Views.Pages.ExportPage"
             x:DataType="vm:ExportPageViewModel">
    <Grid>
        <ListBox Margin="10" Background="Transparent" ItemsSource="{Binding Exports}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="*,2*,2*,*">
                        <TextBlock Grid.Column="0" Text="{Binding AutoTitle}" Foreground="White" />
                        <TextBlock Grid.Column="1" Text="{Binding ExportFile}" Foreground="#AAAAAA" FontSize="11" />
                        <TextBlock Grid.Column="2" Text="{Binding ExportTime}" Foreground="#AAAAAA" FontSize="11" />
                        <TextBlock Grid.Column="3" Text="{Binding FileSize}" Foreground="#AAAAAA" FontSize="11" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
