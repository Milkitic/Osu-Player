<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OsuPlayer.Avalonia.ViewModels"
             x:Class="OsuPlayer.Avalonia.Views.Pages.RecentPlayPage"
             x:DataType="vm:RecentPlayPageViewModel">
    <Grid RowDefinitions="Auto,*">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="10">
            <Button Content="Play All" Classes="style-collection" Command="{Binding PlayAllCommand}" />
            <Button Content="Delete All" Classes="style-collection" />
        </StackPanel>
        <ListBox Grid.Row="1"
                 Background="Transparent"
                 ItemsSource="{Binding Beatmaps}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="40,*,*,*,*">
                        <TextBlock Grid.Column="0" Text="{Binding Index}" Foreground="#FF9C9C9C" />
                        <TextBlock Grid.Column="1" Text="{Binding AutoTitle}" Foreground="White" />
                        <TextBlock Grid.Column="2" Text="{Binding AutoArtist}" Foreground="#FF9C9C9C" />
                        <TextBlock Grid.Column="3" Text="{Binding AutoCreator}" Foreground="White" />
                        <TextBlock Grid.Column="4" Text="{Binding AutoVersion}" Foreground="#FF9C9C9C" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
