<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OsuPlayer.Avalonia.ViewModels"
             x:Class="OsuPlayer.Avalonia.Views.Pages.SearchPage"
             x:DataType="vm:SearchPageViewModel">
    <Grid RowDefinitions="Auto,Auto,*">
        <TextBox Grid.Row="0" Margin="10"
                 Watermark="Search..."
                 Text="{Binding SearchText, Mode=TwoWay}" />
        <Button Grid.Row="1" Margin="10,0" Content="Search"
                Classes="style-collection"
                HorizontalAlignment="Left"
                Command="{Binding SearchCommand}" />
        <ListBox Grid.Row="2" Margin="10"
                 Background="Transparent"
                 ItemsSource="{Binding Results}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="Bold" />
                        <TextBlock Text="{Binding Artist}" Foreground="#AAAAAA" FontSize="11" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
