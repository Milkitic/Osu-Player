<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OsuPlayer.Avalonia.Views.UserControls.SelectCollectionControl">
    <Border Background="#252526" Padding="16" CornerRadius="8">
        <StackPanel Spacing="8">
            <TextBlock Text="Select collection" Foreground="White" FontWeight="Bold" />
            <ListBox Background="Transparent" Height="200">
                <ListBoxItem><TextBlock Text="Favorites" Foreground="White" /></ListBoxItem>
                <ListBoxItem><TextBlock Text="My Collection 1" Foreground="White" /></ListBoxItem>
            </ListBox>
            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                <Button Content="New" Classes="style-collection" />
                <Button Content="Cancel" Classes="style-collection" />
                <Button Content="OK" Classes="style-collection" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
