<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OsuPlayer.Avalonia.Views.UserControls.ClosingControl">
    <Border Background="#252526" Padding="20" CornerRadius="8">
        <StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Are you sure you want to close?" Foreground="White" FontSize="16" HorizontalAlignment="Center" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <Button Content="Yes" Classes="style-collection" />
                <Button Content="No" Classes="style-collection" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
