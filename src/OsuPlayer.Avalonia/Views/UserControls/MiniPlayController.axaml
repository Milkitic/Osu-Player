<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OsuPlayer.Avalonia.Views.UserControls.MiniPlayController">
    <Border Background="#252526" Padding="8" CornerRadius="4">
        <StackPanel Spacing="4">
            <TextBlock Text="Mini Player" Foreground="White" FontWeight="Bold" />
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button Content="⏮" Classes="style-image" Width="24" Height="24" />
                <Button Content="▶" Classes="style-image" Width="24" Height="24" />
                <Button Content="⏭" Classes="style-image" Width="24" Height="24" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
