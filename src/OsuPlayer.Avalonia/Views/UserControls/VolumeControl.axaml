<UserControl
    x:Class="OsuPlayer.Avalonia.Views.UserControls.VolumeControl"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10">
        <StackPanel Spacing="6">
            <TextBlock
                HorizontalAlignment="Center"
                FontWeight="Bold"
                Foreground="White"
                Text="Volume" />
            <Slider
                Width="40"
                Height="120"
                Maximum="1"
                Minimum="0"
                Orientation="Vertical"
                TickFrequency="0.1" />
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="White"
                Text="50%" />
        </StackPanel>
    </Grid>
</UserControl>
