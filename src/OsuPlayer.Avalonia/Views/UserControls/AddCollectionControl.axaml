<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OsuPlayer.Avalonia.Views.UserControls.AddCollectionControl">
    <StackPanel Margin="10" Spacing="6">
        <TextBlock Text="New collection name" Foreground="White" FontWeight="Bold" />
        <TextBox Watermark="Collection name" />
        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
            <Button Content="Cancel" Classes="style-collection" />
            <Button Content="Create" Classes="style-collection" />
        </StackPanel>
    </StackPanel>
</UserControl>
