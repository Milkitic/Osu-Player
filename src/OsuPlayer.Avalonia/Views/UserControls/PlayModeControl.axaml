<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OsuPlayer.Avalonia.Views.UserControls.PlayModeControl">
    <StackPanel Orientation="Horizontal" Spacing="6">
        <Button Classes="style-texture" Content="▶" ToolTip.Tip="Single play" />
        <Button Classes="style-texture" Content="⟳" ToolTip.Tip="Loop single" />
        <Button Classes="style-texture" Content="⇄" ToolTip.Tip="Loop list" />
        <Button Classes="style-texture" Content="⤮" ToolTip.Tip="Random" />
    </StackPanel>
</UserControl>
