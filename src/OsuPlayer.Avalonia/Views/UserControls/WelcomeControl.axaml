<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OsuPlayer.Avalonia.Views.UserControls.WelcomeControl">
    <ScrollViewer>
        <StackPanel Margin="20" Spacing="10">
            <TextBlock Text="Welcome to Osu Player" Foreground="White" FontSize="20" FontWeight="Bold" />
            <TextBlock Text="This is the Avalonia version. Some features are still being migrated from the WPF version."
                       Foreground="#CCCCCC" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
