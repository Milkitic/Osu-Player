<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OsuPlayer.Avalonia.ViewModels"
        x:Class="OsuPlayer.Avalonia.Windows.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Osu Player"
        Width="1100" Height="720"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Title bar -->
        <Border Grid.Row="0" Background="#2D2D30" Padding="16,8">
            <DockPanel>
                <TextBlock Text="Osu Player"
                           Foreground="White"
                           FontSize="16"
                           FontWeight="Bold"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding CurrentSongTitle, StringFormat='Now Playing: {0}'}"
                           Foreground="#AAAAAA"
                           Margin="20,0,0,0"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- Main content area: sidebar + content -->
        <Grid Grid.Row="1" ColumnDefinitions="220,*">
            <!-- Sidebar navigation -->
            <Border Grid.Column="0" Background="#252526" Padding="12">
                <StackPanel Spacing="4">
                    <ToggleButton Classes="nav-button" IsChecked="True" Click="OnNavClick" Tag="Collection">
                        <TextBlock Text="Collection" Foreground="White" />
                    </ToggleButton>
                    <ToggleButton Classes="nav-button" Click="OnNavClick" Tag="Search">
                        <TextBlock Text="Search" Foreground="White" />
                    </ToggleButton>
                    <ToggleButton Classes="nav-button" Click="OnNavClick" Tag="Recent">
                        <TextBlock Text="Recent" Foreground="White" />
                    </ToggleButton>
                    <ToggleButton Classes="nav-button" Click="OnNavClick" Tag="Find">
                        <TextBlock Text="Find" Foreground="White" />
                    </ToggleButton>
                    <ToggleButton Classes="nav-button" Click="OnNavClick" Tag="Settings">
                        <TextBlock Text="Settings" Foreground="White" />
                    </ToggleButton>
                </StackPanel>
            </Border>

            <!-- Content area -->
            <Border Grid.Column="1" Background="#1E1E1E" Padding="20">
                <ContentControl x:Name="MainFrame" />
            </Border>
        </Grid>

        <!-- Bottom playback bar -->
        <Border Grid.Row="2" Background="#2D2D30" Padding="16,8">
            <DockPanel>
                <StackPanel Orientation="Horizontal" Spacing="12" DockPanel.Dock="Left">
                    <Button Classes="style-image" Content="⏮" Width="40" Height="40" />
                    <Button Classes="style-image" Content="▶" Width="40" Height="40" />
                    <Button Classes="style-image" Content="⏭" Width="40" Height="40" />
                </StackPanel>
                <TextBlock Text="{Binding CurrentSongTitle}"
                           Foreground="White"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
