<Application
    x:Class="OsuPlayer.Avalonia.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OsuPlayer.Avalonia"
    RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://OsuPlayer.Avalonia/Styles/BrushDictionary.axaml" />
                <ResourceInclude Source="avares://OsuPlayer.Avalonia/Styles/FontDictionary.axaml" />
                <ResourceInclude Source="avares://OsuPlayer.Avalonia/Styles/ConverterDictionary.axaml" />
                <ResourceInclude Source="avares://OsuPlayer.Avalonia/Styles/GeneralStyle.axaml" />
                <ResourceInclude Source="avares://OsuPlayer.Avalonia/Styles/ScrollBarStyle.axaml" />
                <ResourceInclude Source="avares://OsuPlayer.Avalonia/Styles/i18n.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://OsuPlayer.Avalonia/Styles/ButtonStyle.axaml" />
        <StyleInclude Source="avares://OsuPlayer.Avalonia/Styles/SliderStyle.axaml" />
        <StyleInclude Source="avares://OsuPlayer.Avalonia/Styles/NavigationStyle.axaml" />
    </Application.Styles>
</Application>
