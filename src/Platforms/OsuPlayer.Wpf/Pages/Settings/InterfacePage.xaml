<Page
    x:Class="OsuPlayer.Pages.Settings.InterfacePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:OsuPlayer.Pages.Settings"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:OsuPlayer.ViewModels"
    Title="InterfacePage"
    d:DataContext="{d:DesignInstance viewModels:InterfacePageViewModel,
                                     IsDesignTimeCreatable=True}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    FontFamily="{StaticResource SspRegular}"
    mc:Ignorable="d">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10">
                <Label Content="{DynamicResource ui-sets-title-language}" Style="{StaticResource ConfigTitleStyle}" />
                <ComboBox
                    x:Name="LanguageComboBox"
                    Width="220"
                    Margin="8,0"
                    HorizontalAlignment="Left"
                    ItemsSource="{Binding AvailableLanguages}"
                    SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}" />
                <Label Content="{DynamicResource ui-sets-title-minimalEffectMode}" Style="{StaticResource ConfigTitleStyle}" />
                <CheckBox
                    x:Name="RunOnStartup"
                    Margin="8,0"
                    HorizontalAlignment="Left"
                    IsChecked="{Binding MinimalMode, Mode=TwoWay}"
                    Style="{StaticResource ScrollCheckBox}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
