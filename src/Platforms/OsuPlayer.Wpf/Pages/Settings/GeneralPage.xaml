<Page
    x:Class="OsuPlayer.Pages.Settings.GeneralPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:buttonComponent="clr-namespace:OsuPlayer.UiComponents.ButtonComponent"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loaderComponent="clr-namespace:OsuPlayer.UiComponents.LoaderComponent"
    xmlns:local="clr-namespace:OsuPlayer.Pages.Settings"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:textBoxComponent="clr-namespace:OsuPlayer.UiComponents.TextBoxComponent"
    xmlns:viewModels="clr-namespace:OsuPlayer.ViewModels"
    Title="GeneralPage"
    d:DataContext="{d:DesignInstance viewModels:GeneralPageViewModel,
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    FontFamily="{StaticResource SspRegular}"
    mc:Ignorable="d">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10">
                <Label
                    HorizontalAlignment="Left"
                    Content="{DynamicResource ui-sets-title-startup}"
                    Style="{StaticResource ConfigTitleStyle}" />
                <CheckBox
                    x:Name="RunOnStartup"
                    Margin="8,0"
                    HorizontalAlignment="Left"
                    IsChecked="{Binding RunOnStartup, Mode=TwoWay}"
                    Content="{DynamicResource ui-sets-content-runOnStartup}"
                    Style="{StaticResource CommonCheckBox}" />
                <Label
                    HorizontalAlignment="Left"
                    Content="{DynamicResource ui-sets-title-osuDbLocation}"
                    Style="{StaticResource ConfigTitleStyle}" />
                <StackPanel Orientation="Horizontal" Style="{StaticResource ConfigStackHoriStyle}">
                    <textBoxComponent:CommonTextBox
                        x:Name="TbDbPath"
                        Width="250"
                        Height="27"
                        Margin="5,0,-1,0"
                        VerticalContentAlignment="Center"
                        Background="White"
                        CornerRadius="5"
                        IsReadOnly="True"
                        Text="{Binding DbPath, Mode=OneWay}" />
                    <buttonComponent:CommonButton
                        x:Name="BrowseDb"
                        Width="27"
                        Height="27"
                        Margin="0"
                        Padding="0"
                        VerticalAlignment="Center"
                        Background="#E3E3E3"
                        BorderBrush="#B0B0B0"
                        Command="{Binding BrowseDbCommand}"
                        IconMargin="0"
                        IconTemplate="{StaticResource FolderTempl}"
                        IsEnabled="{Binding ScannerViewModel.IsScanning, Converter={StaticResource NegativeBooleanConverter}}"
                        Style="{StaticResource SettingsButton}" />
                    <buttonComponent:CommonButton
                        x:Name="SyncNow"
                        Height="25"
                        Margin="6,0,0,0"
                        Padding="5,0"
                        VerticalAlignment="Center"
                        Background="#E3E3E3"
                        Command="{Binding SyncNowCommand}"
                        Content="{DynamicResource ui-btn-syncManually}"
                        IsEnabled="{Binding ScannerViewModel.IsScanning, Converter={StaticResource NegativeBooleanConverter}}"
                        Style="{StaticResource SettingsButton}" />
                </StackPanel>
                <Label
                    HorizontalAlignment="Left"
                    Content="{DynamicResource ui-sets-title-customSongPath}"
                    Style="{StaticResource ConfigTitleStyle}" />
                <StackPanel Orientation="Horizontal" Style="{StaticResource ConfigStackHoriStyle}">
                    <textBoxComponent:CommonTextBox
                        x:Name="TbCustomPath"
                        Width="250"
                        Height="27"
                        Margin="5,0,-1,0"
                        VerticalContentAlignment="Center"
                        Background="White"
                        CornerRadius="5"
                        IsReadOnly="True"
                        Text="{Binding CustomSongsPath, Mode=OneWay}" />
                    <buttonComponent:CommonButton
                        x:Name="BrowseCustom"
                        Width="27"
                        Height="27"
                        Margin="0"
                        Padding="0"
                        VerticalAlignment="Center"
                        Background="#E3E3E3"
                        BorderBrush="#B0B0B0"
                        Command="{Binding BrowseCustomCommand}"
                        IconMargin="0"
                        IconTemplate="{StaticResource FolderTempl}"
                        Style="{StaticResource SettingsButton}" />
                    <buttonComponent:CommonButton
                        x:Name="btnStartScan"
                        Height="25"
                        Margin="6,0,0,0"
                        Padding="5,0"
                        VerticalAlignment="Center"
                        Background="#E3E3E3"
                        Command="{Binding ScanNowCommand}"
                        Content="{DynamicResource ui-btn-scanManually}"
                        Style="{StaticResource SettingsButton}"
                        Visibility="{Binding ScannerViewModel.IsScanning, Converter={StaticResource BoolFalseToVisibleConverter}}" />
                    <loaderComponent:Loader
                        Width="25"
                        Height="25"
                        FillColor="#303030"
                        Visibility="{Binding ScannerViewModel.IsScanning, Converter={StaticResource TrueToVisibleConverter}}" />
                    <Label
                        Content="{DynamicResource ui-sets-content-scanning3Dot}"
                        Foreground="#303030"
                        Visibility="{Binding ScannerViewModel.IsScanning, Converter={StaticResource TrueToVisibleConverter}}" />
                    <buttonComponent:CommonButton
                        x:Name="CancelScan"
                        Padding="2,0"
                        VerticalAlignment="Center"
                        Command="{Binding CancelScanCommand}"
                        Content="{DynamicResource ui-btn-cancelScan}"
                        Style="{StaticResource LinkButton}"
                        Visibility="{Binding ScannerViewModel.IsScanning, Converter={StaticResource TrueToVisibleConverter}}" />
                </StackPanel>
                <Label
                    HorizontalAlignment="Left"
                    Content="{DynamicResource ui-sets-title-closeWindow}"
                    Style="{StaticResource ConfigTitleStyle}" />
                <StackPanel Margin="0,-5,0,0" HorizontalAlignment="Left">
                    <RadioButton
                        x:Name="RadioMinimum"
                        Margin="8,0"
                        HorizontalAlignment="Left"
                        IsChecked="{Binding IsMinimizeWhenClosed, Mode=TwoWay}"
                        Content="{DynamicResource ui-sets-content-minToNotificationPanel}"
                        Style="{StaticResource CommonRadioButton}" />
                    <RadioButton
                        x:Name="RadioExit"
                        Margin="8,0"
                        HorizontalAlignment="Left"
                        IsChecked="{Binding IsExitWhenClosed, Mode=TwoWay}"
                        Content="{DynamicResource ui-sets-content-exitProgram}"
                        Style="{StaticResource CommonRadioButton}" />
                    <CheckBox
                        x:Name="AsDefault"
                        Margin="8,10"
                        HorizontalAlignment="Left"
                        IsChecked="{Binding SetAsDefaultOptions, Mode=TwoWay}"
                        Content="{DynamicResource ui-sets-content-setAsDefaultOptions}"
                        Style="{StaticResource CommonCheckBox}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
