<Page
    x:Class="OsuPlayer.Pages.Settings.PlayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:OsuPlayer.Pages.Settings"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:textBoxComponent="clr-namespace:OsuPlayer.UiComponents.TextBoxComponent"
    xmlns:viewModels="clr-namespace:OsuPlayer.ViewModels"
    Title="PlayPage"
    d:DataContext="{d:DesignInstance viewModels:PlayPageViewModel,
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    FontFamily="{StaticResource SspRegular}"
    mc:Ignorable="d">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10">
                <Label
                    HorizontalAlignment="Left"
                    Content="{DynamicResource ui-sets-title-globalHitsoundDelay}"
                    Style="{StaticResource ConfigTitleStyle}" />
                <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                    <Slider
                        x:Name="SliderOffset"
                        Width="300"
                        Margin="8,0"
                        Maximum="200"
                        Minimum="-200"
                        Style="{StaticResource HorizontalSliderWhiteStyle}"
                        Value="{Binding GeneralOffset, Mode=TwoWay}" />
                    <textBoxComponent:CommonTextBox
                        x:Name="BoxOffset"
                        Width="35"
                        Background="White"
                        CornerRadius="2"
                        TextAlignment="Center"
                        Text="{Binding GeneralOffset, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                </StackPanel>
                <Label
                    HorizontalAlignment="Left"
                    Content="播放列表："
                    Style="{StaticResource ConfigTitleStyle}"
                    Visibility="Collapsed" />
                <StackPanel HorizontalAlignment="Left">
                    <RadioButton
                        x:Name="RadioReplace"
                        IsChecked="{Binding ReplacePlayList, Mode=TwoWay}"
                        Content="播放单曲时，用此单曲所在的歌曲列表替换播放列表"
                        Style="{StaticResource ConfigRadioStyle}"
                        Visibility="Collapsed" />
                    <RadioButton
                        x:Name="RadioInsert"
                        IsChecked="{Binding InsertPlayList, Mode=TwoWay}"
                        Content="播放单曲时，仅把此单曲添加到播放列表"
                        Style="{StaticResource ConfigRadioStyle}"
                        Visibility="Collapsed" />
                </StackPanel>
                <Label
                    HorizontalAlignment="Left"
                    Content="{DynamicResource ui-sets-title-autoPlay}"
                    Style="{StaticResource ConfigTitleStyle}" />
                <CheckBox
                    x:Name="ChkAutoPlay"
                    Margin="8,0"
                    HorizontalAlignment="Left"
                    IsChecked="{Binding AutoPlay, Mode=TwoWay}"
                    Content="{DynamicResource ui-sets-content-autoPlayOnProgramStartup}"
                    Style="{StaticResource CommonCheckBox}" />
                <Label
                    HorizontalAlignment="Left"
                    Content="{DynamicResource ui-sets-title-playProgress}"
                    Style="{StaticResource ConfigTitleStyle}" />
                <CheckBox
                    x:Name="ChkMemory"
                    Margin="8,0"
                    HorizontalAlignment="Left"
                    IsChecked="{Binding Memory, Mode=TwoWay}"
                    Content="{DynamicResource ui-sets-content-resumePlaylistOnProgramStartup}"
                    Style="{StaticResource CommonCheckBox}" />
                <Label
                    HorizontalAlignment="Left"
                    Content="{DynamicResource ui-sets-title-audioPlayDevice}"
                    Style="{StaticResource ConfigTitleStyle}" />
                <ComboBox
                    x:Name="DeviceInfoCombo"
                    Width="320"
                    Margin="8,0"
                    HorizontalAlignment="Left"
                    ItemsSource="{Binding AvailableDevices}"
                    SelectedItem="{Binding SelectedDevice, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource DeviceInfoToStringConverter}}"/> 
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
