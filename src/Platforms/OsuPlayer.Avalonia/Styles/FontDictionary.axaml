<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--  Avalonia 字体通过 app.manifest 或 App.axaml.cs 注册,这里用 avares:// 引用  -->
    <FontFamily x:Key="SspExtraLight">avares://OsuPlayer/Resources/Fonts/SourceSansPro-ExtraLight.ttf#Source Sans Pro</FontFamily>
    <FontFamily x:Key="SspLight">avares://OsuPlayer/Resources/Fonts/SourceSansPro-Light.ttf#Source Sans Pro</FontFamily>
    <FontFamily x:Key="SspRegular">avares://OsuPlayer/Resources/Fonts/SourceSansPro-Regular.ttf#Source Sans Pro</FontFamily>
    <FontFamily x:Key="SspSemibold">avares://OsuPlayer/Resources/Fonts/SourceSansPro-Semibold.ttf#Source Sans Pro</FontFamily>
    <FontFamily x:Key="SspBlack">avares://OsuPlayer/Resources/Fonts/SourceSansPro-Black.ttf#Source Sans Pro</FontFamily>
</ResourceDictionary>
