<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:OsuPlayer.Controls">

    <Design.PreviewWith>

        <Border Padding="15">
            <Border.Styles>
                <Style Selector="controls|CommonButton.transport-accent">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Background" Value="{DynamicResource OsuTextureBlueBrush}" />
                    <Setter Property="BorderBrush" Value="White" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="BoxShadow" Value="0 1 10 0 #E65D9CEC" />
                    <Setter Property="IconMargin" Value="0" />
                    <Setter Property="IconSize" Value="24" />
                    <Setter Property="MouseOverForeground" Value="White" />
                    <Setter Property="MouseDownForeground" Value="White" />
                    <Setter Property="MouseOverBackground">
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0" Color="#5D9CEC" />
                            <GradientStop Offset="1" Color="#4D8CDC" />
                        </LinearGradientBrush>
                    </Setter>
                    <Setter Property="MouseDownBackground">
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0" Color="#3D7CCC" />
                            <GradientStop Offset="1" Color="#4D8CDC" />
                        </LinearGradientBrush>
                    </Setter>
                </Style>
            </Border.Styles>
            <StackPanel>
                <Viewbox Width="256" Height="256">
                    <controls:CommonButton
                        Width="28"
                        Height="28"
                        Margin="8"
                        Classes="transport-accent"
                        CornerRadius="14"
                        IconTemplate="{StaticResource OpenTempl}" />
                </Viewbox>
            </StackPanel>
        </Border>
    </Design.PreviewWith>

    <Style Selector="controls|CommonButton">
        <Setter Property="Background" Value="#F0F0F0" />
        <Setter Property="BorderBrush" Value="#F0F0F0" />
        <Setter Property="Foreground" Value="#484848" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Height" Value="36" />
        <Setter Property="MouseOverBackground" Value="#F3F5F5" />
        <Setter Property="MouseOverForeground" Value="#484848" />
        <Setter Property="MouseDownBackground" Value="#E8E8E8" />
        <Setter Property="MouseDownForeground" Value="#323232" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    x:Name="PART_Border"
                    Width="{TemplateBinding Width}"
                    Height="{TemplateBinding Height}"
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    BoxShadow="{TemplateBinding BoxShadow}"
                    CornerRadius="{TemplateBinding CornerRadius}">
                    <StackPanel
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                        Orientation="{TemplateBinding controls:CommonButton.IconOrientation}">
                        <Viewbox
                            Width="{TemplateBinding controls:CommonButton.IconSize}"
                            Height="{TemplateBinding controls:CommonButton.IconSize}"
                            Margin="{TemplateBinding controls:CommonButton.IconMargin}"
                            VerticalAlignment="Center"
                            IsVisible="{Binding $parent[controls:CommonButton].IconTemplate, Converter={StaticResource NullToBoolFalseConverter}}"
                            Stretch="Uniform">
                            <ContentControl
                                x:Name="PART_Icon"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{TemplateBinding Foreground}"
                                Template="{TemplateBinding controls:CommonButton.IconTemplate}" />
                        </Viewbox>
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Content}" />
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="controls|CommonButton:pointerover /template/ Border#PART_Border">
        <Setter Property="Background" Value="{Binding $parent[controls:CommonButton].MouseOverBackground}" />
        <Setter Property="TextBlock.Foreground" Value="{Binding $parent[controls:CommonButton].MouseOverForeground}" />
    </Style>

    <Style Selector="controls|CommonButton:pointerover /template/ ContentControl#PART_Icon">
        <Setter Property="Foreground" Value="{Binding $parent[controls:CommonButton].MouseOverForeground}" />
    </Style>

    <Style Selector="controls|CommonButton:pressed /template/ Border#PART_Border">
        <Setter Property="Background" Value="{Binding $parent[controls:CommonButton].MouseDownBackground}" />
        <Setter Property="TextBlock.Foreground" Value="{Binding $parent[controls:CommonButton].MouseDownForeground}" />
    </Style>

    <Style Selector="controls|CommonButton:pressed /template/ ContentControl#PART_Icon">
        <Setter Property="Foreground" Value="{Binding $parent[controls:CommonButton].MouseDownForeground}" />
    </Style>

    <Style Selector="controls|CommonButton:disabled">
        <Setter Property="Opacity" Value="0.5" />
    </Style>

    <Style Selector="controls|IconRadioButton">
        <Setter Property="Background" Value="#10303030" />
        <Setter Property="Foreground" Value="#484848" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Height" Value="36" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    x:Name="PART_Border"
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    ClipToBounds="True">
                    <StackPanel
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                        Orientation="{TemplateBinding controls:IconRadioButton.IconOrientation}">
                        <Viewbox
                            Width="{TemplateBinding controls:IconRadioButton.IconSize}"
                            Height="{TemplateBinding controls:IconRadioButton.IconSize}"
                            Margin="{TemplateBinding controls:IconRadioButton.IconMargin}"
                            VerticalAlignment="Center"
                            Stretch="Uniform">
                            <ContentControl
                                x:Name="PART_Icon"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Template="{TemplateBinding controls:IconRadioButton.IconTemplate}" />
                        </Viewbox>
                        <ContentPresenter
                            x:Name="PART_ContentPresenter"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Content}" />
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!--  Default icon color (must be a style, not template-local, so state styles can override)  -->
    <Style Selector="controls|IconRadioButton /template/ ContentControl#PART_Icon">
        <Setter Property="Foreground">
            <MultiBinding Converter="{StaticResource IconColorConverter}">
                <Binding Path="$parent[controls:IconRadioButton].Foreground" />
                <Binding Path="$parent[controls:IconRadioButton].IconColor" />
            </MultiBinding>
        </Setter>
    </Style>

    <Style Selector="controls|IconRadioButton:pointerover:not(:checked) /template/ Border#PART_Border">
        <Setter Property="Background" Value="{Binding $parent[controls:IconRadioButton].MouseOverBackground}" />
        <Setter Property="TextBlock.Foreground" Value="{Binding $parent[controls:IconRadioButton].MouseOverForeground}" />
    </Style>
    <Style Selector="controls|IconRadioButton:pointerover:not(:checked) /template/ ContentControl#PART_Icon">
        <Setter Property="Foreground">
            <MultiBinding Converter="{StaticResource IconColorConverter}">
                <Binding Path="$parent[controls:IconRadioButton].MouseOverForeground" />
                <Binding Path="$parent[controls:IconRadioButton].MouseOverIconColor" />
            </MultiBinding>
        </Setter>
    </Style>

    <Style Selector="controls|IconRadioButton:pressed /template/ Border#PART_Border">
        <Setter Property="Background" Value="{Binding $parent[controls:IconRadioButton].MouseDownBackground}" />
        <Setter Property="TextBlock.Foreground" Value="{Binding $parent[controls:IconRadioButton].MouseDownForeground}" />
    </Style>
    <Style Selector="controls|IconRadioButton:pressed /template/ ContentControl#PART_Icon">
        <Setter Property="Foreground">
            <MultiBinding Converter="{StaticResource IconColorConverter}">
                <Binding Path="$parent[controls:IconRadioButton].MouseDownForeground" />
                <Binding Path="$parent[controls:IconRadioButton].MouseDownIconColor" />
            </MultiBinding>
        </Setter>
    </Style>

    <Style Selector="controls|IconRadioButton:checked /template/ Border#PART_Border">
        <Setter Property="Background" Value="{Binding $parent[controls:IconRadioButton].CheckedBackground}" />
        <Setter Property="TextBlock.Foreground" Value="{Binding $parent[controls:IconRadioButton].CheckedForeground}" />
    </Style>
    <Style Selector="controls|IconRadioButton:checked /template/ ContentControl#PART_Icon">
        <Setter Property="Foreground">
            <MultiBinding Converter="{StaticResource IconColorConverter}">
                <Binding Path="$parent[controls:IconRadioButton].CheckedForeground" />
                <Binding Path="$parent[controls:IconRadioButton].CheckedIconColor" />
            </MultiBinding>
        </Setter>
    </Style>

    <Style Selector="controls|IconRadioButton:disabled">
        <Setter Property="Opacity" Value="0.5" />
    </Style>

    <Style Selector="controls|CommonTextBox">
        <Setter Property="CaretBrush" Value="#303030" />
        <Setter Property="SelectionBrush" Value="#646464" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Width" Value="100" />
        <Setter Property="Background" Value="White" />
        <Setter Property="Foreground" Value="#303030" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderBrush" Value="#B0B0B0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

</Styles>
