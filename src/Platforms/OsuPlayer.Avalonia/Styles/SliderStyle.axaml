<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="Slider.osu-slider">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource SliderBackground}" />
        <Setter Property="Background" Value="#EAEAEA" />
        <Setter Property="Height" Value="20" />
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="MinWidth" Value="40" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Slider.osu-slider /template/ Track">
        <Setter Property="Height" Value="5" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Slider.osu-slider /template/ RepeatButton#PART_DecreaseButton">
        <Setter Property="Background" Value="{DynamicResource SliderBackground}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="Slider.osu-slider /template/ RepeatButton#PART_IncreaseButton">
        <Setter Property="Background" Value="#EAEAEA" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="Slider.osu-slider /template/ Thumb">
        <Setter Property="Width" Value="15" />
        <Setter Property="Height" Value="15" />
        <Setter Property="Background" Value="{DynamicResource SliderBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WhiteBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CornerRadius" Value="7.5" />
        <Setter Property="Margin" Value="-5" />
    </Style>
</Styles>
