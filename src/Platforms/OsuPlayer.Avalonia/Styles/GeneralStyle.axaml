<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--  Texture brushes  -->
    <Bitmap x:Key="TextureSource1">avares://OsuPlayer/Resources/osu_texture.png</Bitmap>
    <Bitmap x:Key="TextureSource2">avares://OsuPlayer/Resources/osu_texture2.png</Bitmap>
    <Bitmap x:Key="TextureSource3">avares://OsuPlayer/Resources/store.jpg</Bitmap>
    <Bitmap x:Key="OsuTextureBlue">avares://OsuPlayer/Resources/osu_texture_blue.png</Bitmap>

    <!--
        Avalonia ImageBrush 平铺:
        - Stretch=None: 图片保持原始尺寸 (等效 WPF Viewport=0,0,{imgW},{imgH} AbsolutePixels)
        - TileMode=Tile: 平铺填充整个背景
    -->
    <ImageBrush x:Key="TextureBrush" Source="{StaticResource TextureSource1}" Stretch="None" TileMode="Tile" />
    <ImageBrush x:Key="TextureBrush2" Source="{StaticResource TextureSource2}" Stretch="None" TileMode="Tile" />
    <ImageBrush x:Key="TextureBrush3" Source="{StaticResource TextureSource3}" Stretch="UniformToFill" />
    <ImageBrush x:Key="OsuTextureBlueBrush" Source="{StaticResource OsuTextureBlue}" Stretch="None" TileMode="Tile" />

    <SolidColorBrush x:Key="DarkGreyBrush30" Color="#303030" />

    <!--  Geometry resources  -->
    <StreamGeometry x:Key="Mini">M192,195 L182,195 182,180 205,180 205,195 195,195 195,189 200,189 193.5,183 187,189 192,189</StreamGeometry>

