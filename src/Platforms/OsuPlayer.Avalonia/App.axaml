<Application
    x:Class="OsuPlayer.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:OsuPlayer"
    xmlns:smoothScroll="clr-namespace:SmoothScroll.Avalonia.Controls;assembly=SmoothScroll.Avalonia.Controls"
    xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    RequestedThemeVariant="Light">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://OsuPlayer/Assets/Brushes.axaml" />
                <ResourceInclude Source="avares://OsuPlayer/Assets/Fonts/FontDictionary.axaml" />
                <ResourceInclude Source="avares://OsuPlayer/Converters/ConverterDictionary.axaml" />
                <ResourceInclude Source="avares://OsuPlayer/Styles/GeneralStyle.axaml" />
                <ResourceInclude Source="avares://OsuPlayer/lang/i18n.axaml" />
                <ResourceInclude Source="avares://OsuPlayer/Assets/Icons.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!--  Global Font Styling  -->
        <Style Selector="Window">
            <Setter Property="FontFamily" Value="{StaticResource SspRegular}" />
        </Style>
        <Style Selector="ContextMenu">
            <Setter Property="FontFamily" Value="{StaticResource SspRegular}" />
        </Style>
        <Style Selector="ToolTip">
            <Setter Property="FontFamily" Value="{StaticResource SspRegular}" />
        </Style>

        <StyleInclude Source="avares://OsuPlayer/Styles/ButtonStyle.axaml" />
        <StyleInclude Source="avares://OsuPlayer/Styles/SliderStyle.axaml" />
        <StyleInclude Source="avares://OsuPlayer/Styles/NavigationStyle.axaml" />
        <StyleInclude Source="avares://OsuPlayer/Styles/ScrollBarTheme.axaml" />
        <StyleInclude Source="avares://OsuPlayer/Styles/ContextMenuStyle.axaml" />
        <StyleInclude Source="avares://OsuPlayer/Styles/Components.axaml" />
        <StyleInclude Source="avares://OsuPlayer/Styles/BeatmapListStyle.axaml" />
        <StyleInclude Source="avares://OsuPlayer/Styles/CommonButtonStyle.axaml" />
        <StyleInclude Source="avares://OsuPlayer/Styles/ConfigStyle.axaml" />
        <StyleInclude Source="avares://OsuPlayer/Themes/CommonButton.axaml" />
        <StyleInclude Source="avares://OsuPlayer/Themes/Dialog.axaml" />

        <smoothScroll:ScrollViewerSmoothTheme />
        <materialIcons:MaterialIconStyles />
    </Application.Styles>

    <!-- 托盘图标在 App.axaml.cs 中通过 TrayIcons 集合程序化创建并附加。
         Avalonia 12 的 TrayIcons 是附加属性,TrayIcon 必须直接放在 <TrayIcons> 集合中。-->
</Application>
