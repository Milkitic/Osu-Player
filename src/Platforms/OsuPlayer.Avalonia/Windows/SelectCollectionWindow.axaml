<Window
    x:Class="OsuPlayer.Windows.SelectCollectionWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lang="clr-namespace:OsuPlayer.Lang"
    xmlns:controls="clr-namespace:OsuPlayer.Views.UserControls"
    Title="{I18N {x:Static lang:SRKeys.Ui_Nav_Collection}}"
    Width="350"
    Height="400"
    MinWidth="350"
    MinHeight="400"
    MaxWidth="350"
    MaxHeight="400"
    WindowStartupLocation="CenterOwner"
    WindowDecorations="None"
    ExtendClientAreaToDecorationsHint="True"
    ExtendClientAreaTitleBarHeightHint="32">

    <Grid Margin="{Binding $parent[Window].OffScreenMargin}" RowDefinitions="Auto,*">
        <controls:WindowTitleBar
            Height="32"
            Background="#323232"
            LeftAreaMargin="8,0,0,0"
            RightAreaMargin="0,0,1,0"
            Title="{I18N {x:Static lang:SRKeys.Ui_Nav_Collection}}"
            ShowMinimize="False"
            ShowMaximize="False" />

        <Border Grid.Row="1" Background="#FEFEFE" Padding="15">
            <controls:SelectCollectionControl x:Name="ContentHost" />
        </Border>
    </Grid>
</Window>
