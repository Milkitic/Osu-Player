<Window
    x:Class="OsuPlayer.Windows.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:OsuPlayer.Views.UserControls"
    xmlns:data="clr-namespace:OsuPlayer.Data.Models;assembly=OsuPlayer.Data"
    xmlns:ui="clr-namespace:OsuPlayer.Controls"
    xmlns:vm="clr-namespace:OsuPlayer.ViewModels"
    Title="Osu Player"
    Width="998"
    Height="759"
    MinWidth="800"
    MinHeight="600"
    x:DataType="vm:MainWindowViewModel"
    ExtendClientAreaTitleBarHeightHint="40"
    ExtendClientAreaToDecorationsHint="True"
    Icon="avares://OsuPlayer/osuPlayer.ico"
    WindowDecorations="BorderOnly"
    WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Grid Margin="{Binding $parent[Window].OffScreenMargin}" RowDefinitions="Auto,*">
        <Grid.Background>
            <ImageBrush
                AlignmentX="Left"
                AlignmentY="Top"
                DestinationRect="0,0,500,500"
                Source="{StaticResource TextureSource1}"
                Stretch="None"
                TileMode="Tile" />
        </Grid.Background>

        <!--  标题栏  -->
        <controls:WindowTitleBar
            Grid.Row="0"
            Background="Transparent"
            LeftAreaMargin="10,0,0,0"
            RightAreaMargin="0,0,5,0">
            <controls:WindowTitleBar.LeftContent>
                <Image Height="28" Source="{Binding IsNavigationCollapsed, Converter={StaticResource TitleIconConverter}}" />
            </controls:WindowTitleBar.LeftContent>
            <controls:WindowTitleBar.RightContent>
                <Border
                    Height="32"
                    Margin="0,0,10,0"
                    Padding="6,2"
                    VerticalAlignment="Center"
                    BorderBrush="#60DDDDDD"
                    BorderThickness="0.3"
                    CornerRadius="16">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button
                            Width="26"
                            Height="26"
                            Classes="titlebar-btn"
                            Click="BtnSettings_Click"
                            ToolTip.Tip="{DynamicResource ui-sets}">
                            <Viewbox Width="18" Height="18">
                                <Path Data="{StaticResource Gear}" Fill="White" />
                            </Viewbox>
                        </Button>
                        <Button
                            Width="26"
                            Height="26"
                            Classes="titlebar-btn"
                            Click="BtnMini_Click"
                            ToolTip.Tip="Mini">
                            <Viewbox Width="14" Height="14">
                                <Canvas Width="1024" Height="1024">
                                    <Path Data="M0.739556 233.130667a232.391111 232.391111 0 0 1 232.391111-232.391111h557.738666a232.391111 232.391111 0 0 1 232.391111 232.391111v557.738666a232.391111 232.391111 0 0 1-232.391111 232.391111H233.130667a232.391111 232.391111 0 0 1-232.391111-232.391111V233.130667z m232.391111-139.434667a139.434667 139.434667 0 0 0-139.434667 139.434667v557.738666a139.434667 139.434667 0 0 0 139.434667 139.434667h557.738666a139.434667 139.434667 0 0 0 139.434667-139.434667V233.130667a139.434667 139.434667 0 0 0-139.434667-139.434667H233.130667z" Fill="White" />
                                    <Path Data="M601.088 186.652444c25.685333 0 46.506667 20.792889 46.506667 46.478223v96.796444c0 25.685333 20.792889 46.478222 46.478222 46.478222h96.796444a46.478222 46.478222 0 1 1 0 92.984889h-96.796444a139.434667 139.434667 0 0 1-139.463111-139.463111V233.130667c0-25.685333 20.821333-46.478222 46.478222-46.478223z m-414.435556 414.435556c0-25.656889 20.792889-46.478222 46.478223-46.478222h96.796444a139.434667 139.434667 0 0 1 139.463111 139.463111v96.796444a46.478222 46.478222 0 0 1-92.984889 0v-96.796444c0-25.685333-20.792889-46.478222-46.478222-46.478222H233.130667a46.478222 46.478222 0 0 1-46.478223-46.506667z" Fill="White" />
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </StackPanel>
                </Border>
            </controls:WindowTitleBar.RightContent>
        </controls:WindowTitleBar>

        <!--  主内容区  -->
        <Grid Grid.Row="1" RowDefinitions="*,Auto">

            <!--  导航栏 + 内容区  -->
            <Grid
                Grid.Row="0"
                Margin="0,0,1,0"
                ColumnDefinitions="Auto,*">
                <!--  侧边栏 StackPanel  -->
                <Border
                    x:Name="SidebarHost"
                    Grid.Column="0"
                    Width="170"
                    Padding="0,12,0,0">
                    <Border.Transitions>
                        <Transitions>
                            <DoubleTransition
                                Easing="QuarticEaseInOut"
                                Property="Width"
                                Duration="0:0:0.3" />
                        </Transitions>
                    </Border.Transitions>
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="NavPanel" Spacing="1">

                            <!--  折叠按钮  -->
                            <Button
                                x:Name="CollapseButton"
                                Height="36"
                                Padding="13,0,0,0"
                                HorizontalAlignment="Stretch"
                                Classes="nav-button"
                                Click="OnCollapseClick">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Viewbox
                                        Width="20"
                                        Height="20"
                                        VerticalAlignment="Center">
                                        <Canvas Width="1000" Height="1000">
                                            <Path Data="M935.6 255H64.4C31.8 255 10 233.2 10 200.6c0-32.7 21.8-54.4 54.4-54.4h871.1c32.7 0 54.4 21.8 54.4 54.4C990 233.2 968.2 255 935.6 255z" Fill="White" />
                                            <Path Data="M935.6 853.9H64.4c-32.7 0-54.4-21.8-54.4-54.4c0-32.7 21.8-54.4 54.4-54.4h871.1c32.7 0 54.4 21.8 54.4 54.4C990 832.1 968.2 853.9 935.6 853.9z" Fill="White" />
                                            <Path Data="M935.6 554.4H64.4C31.8 554.4 10 532.7 10 500c0-32.7 21.8-54.4 54.4-54.4h871.1c32.7 0 54.4 21.8 54.4 54.4C990 532.7 968.2 554.4 935.6 554.4z" Fill="White" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock
                                        x:Name="CollapseButtonText"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Foreground="White"
                                        Text="{DynamicResource ui-collapse}" />
                                </StackPanel>
                            </Button>

                            <!--  库 分类标题  -->
                            <TextBlock
                                x:Name="LibraryHeader"
                                Margin="20,10,0,2"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="#c8c8c8"
                                Text="{DynamicResource ui-nav-library}" />

                            <!--  搜索按钮  -->
                            <RadioButton
                                x:Name="SearchNavButton"
                                Classes="nav-button"
                                Click="OnNavClick"
                                GroupName="MainNav"
                                IsChecked="True"
                                Tag="Search">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Viewbox
                                        Width="20"
                                        Height="20"
                                        VerticalAlignment="Center">
                                        <Canvas Width="1000" Height="1000">
                                            <Path Data="M914.6 990c-20 0-39.5-8.2-53-22.4l-202-201.4c-68.9 47.7-151.4 73-235 73C195.5 839.2 10 653.7 10 424.6C10 195.5 195.5 10 424.6 10c229.1 0 414.6 185.5 414.6 414.6c0 83.6-25.3 166.1-73 235l202 202c13.5 13.5 21.8 33 21.8 53C990 955.8 955.8 990 914.6 990L914.6 990z M424.6 160.8c-145.5 0-263.8 118.4-263.8 263.8c0 145.5 118.4 263.9 263.8 263.9c145.5 0 263.8-118.4 263.8-263.9C688.5 279.1 570.1 160.8 424.6 160.8L424.6 160.8z" Fill="{Binding $parent[RadioButton].Foreground}" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock
                                        x:Name="SearchNavText"
                                        VerticalAlignment="Center"
                                        Text="{DynamicResource ui-nav-search}" />
                                </StackPanel>
                            </RadioButton>

                            <!--  音乐 (Find)  -->
                            <RadioButton
                                x:Name="FindNavButton"
                                Classes="nav-button"
                                Click="OnNavClick"
                                GroupName="MainNav"
                                Tag="Find">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Viewbox
                                        Width="20"
                                        Height="20"
                                        VerticalAlignment="Center">
                                        <Canvas Width="1000" Height="1000">
                                            <Path Data="M500 10C229.4 10 10 229.4 10 500c0 270.6 219.4 490 490 490s490-219.4 490-490C990 229.4 770.6 10 500 10z M500 860.1c-198.6 0-360.1-161.5-360.1-360.1c0-198.5 161.5-360.1 360.1-360.1c198.6 0 360.1 161.6 360.1 360.1C860.1 698.6 698.6 860.1 500 860.1z" Fill="{Binding $parent[RadioButton].Foreground}" />
                                            <Path Data="M691.7 273.8L436.4 426c-3.5 2-6.4 5-8.4 8.4L273.8 691.7c-5.8 9.6-4.2 22 3.8 29.9l1 1c4.7 4.6 10.9 7 17.1 7c4.3 0 8.6-1.2 12.5-3.5l257.3-154c3.4-2.1 6.3-5 8.4-8.4l152.2-255.4c5.7-9.5 3.2-22.7-4.6-30.6C713.7 269.6 701.4 268 691.7 273.8z" Fill="{Binding $parent[RadioButton].Foreground}" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock
                                        x:Name="FindNavText"
                                        VerticalAlignment="Center"
                                        Text="{DynamicResource ui-nav-music}" />
                                </StackPanel>
                            </RadioButton>

                            <!--  我的 分类标题  -->
                            <TextBlock
                                x:Name="MineHeader"
                                Margin="20,10,0,2"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="#c8c8c8"
                                Text="{DynamicResource ui-nav-mine}" />

                            <!--  最近播放  -->
                            <RadioButton
                                x:Name="RecentNavButton"
                                Classes="nav-button"
                                Click="OnNavClick"
                                GroupName="MainNav"
                                Tag="Recent">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Viewbox
                                        Width="20"
                                        Height="20"
                                        VerticalAlignment="Center">
                                        <Canvas Width="1000" Height="1000">
                                            <Path Data="M500 10C229.4 10 10 229.4 10 500c0 270.6 219.4 490 490 490c270.6 0 490-219.4 490-490C990 229.4 770.6 10 500 10z M500 867.5c-202.6 0-367.5-164.9-367.5-367.5c0-202.6 164.9-367.5 367.5-367.5c202.6 0 367.5 164.9 367.5 367.5C867.5 702.7 702.6 867.5 500 867.5z M561.2 255l-122.5 0l0 306.2h122.5v0l183.7 0V438.7l-183.7 0L561.2 255z" Fill="{Binding $parent[RadioButton].Foreground}" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock
                                        x:Name="RecentNavText"
                                        VerticalAlignment="Center"
                                        Text="{DynamicResource ui-nav-recent}" />
                                </StackPanel>
                            </RadioButton>

                            <!--  导出  -->
                            <RadioButton
                                x:Name="ExportNavButton"
                                Classes="nav-button"
                                Click="OnNavClick"
                                GroupName="MainNav"
                                Tag="Export">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Viewbox
                                        Width="20"
                                        Height="20"
                                        VerticalAlignment="Center">
                                        <Canvas Width="1000" Height="1000">
                                            <Canvas.RenderTransform>
                                                <TransformGroup>
                                                    <ScaleTransform ScaleX="0.1" ScaleY="-0.1" />
                                                    <TranslateTransform X="0" Y="496" />
                                                </TransformGroup>
                                            </Canvas.RenderTransform>
                                            <Path Data="M4493.8 4986.4c-540.9-55.2-1137-227.9-1648-478.7C1846.9 4017.5 1092 3262.5 604 2268.2C-579-143.9 390-3044 2783.7-4259.3c2412.1-1224.5 5358.2-262.4 6582.7 2147.4c962.1 1896.5 600.7 4184.4-902.3 5685.1C7426.1 4613.6 5962.2 5133.7 4493.8 4986.4z M5202.7 3425.9c34.5-25.3 306.1-292.3 607.6-593.8c453.4-458 547.8-563.9 568.5-642.2c59.8-223.3-96.7-423.5-331.4-423.5c-145 0-170.3 18.4-464.9 308.4l-237.1 232.5v-955.2c0-904.5-2.3-957.5-46-1047.2c-115.1-239.4-439.6-257.8-591.5-34.5c-52.9 75.9-52.9 78.3-52.9 1038c0 531.7-6.9 964.4-16.1 964.4c-9.2 0-128.9-110.5-264.7-246.3c-244-241.7-246.3-244-370.6-255.5c-248.6-20.7-418.9 163.4-372.9 405.1c13.8 73.7 99 168 593.8 669.8c319.9 319.9 612.3 596.1 649.1 614.5C4961 3501.9 5122.1 3485.8 5202.7 3425.9z M4148.6 924V592.6h-391.3c-421.2 0-586.9-23-679-96.7l-57.5-46l4.6-1164.6l6.9-1164.6l80.6-46c80.6-48.3 105.9-48.3 1887.3-48.3c1781.5 0 1806.8 0 1887.3 48.3l80.6 46l6.9 1164.6l4.6 1164.6l-57.5 46c-92.1 73.7-257.8 96.7-679 96.7h-391.3V924v331.4l455.7 2.3c264.7 2.3 508.7-6.9 582.3-23c301.5-62.1 582.3-260.1 699.7-497.2l69.1-133.5V-696.3v-1300.4l-59.8-126.6c-112.8-239.4-379.8-439.6-690.5-511c-94.4-23-547.8-29.9-1919.6-29.9c-1645.7 0-1806.8 2.3-1942.6 41.4c-296.9 80.6-534 264.7-644.5 499.5l-59.9 126.6v1300.4V604.1l52.9 105.9c135.8 271.6 389 455.7 729.6 527.1c50.6 9.2 301.5 18.4 559.3 18.4h464.9V924z" Fill="{Binding $parent[RadioButton].Foreground}" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock
                                        x:Name="ExportNavText"
                                        VerticalAlignment="Center"
                                        Text="{DynamicResource ui-nav-export}" />
                                </StackPanel>
                            </RadioButton>

                            <!--  收藏夹 标题行 (含添加按钮)  -->
                            <Grid
                                x:Name="CollectionHeaderPanel"
                                Margin="20,10,5,2"
                                ColumnDefinitions="*,Auto">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="#c8c8c8"
                                    Text="{DynamicResource ui-nav-collection}" />
                                <ui:CommonButton
                                    x:Name="CollectionAddButton"
                                    Grid.Column="1"
                                    Width="20"
                                    Height="20"
                                    Padding="0"
                                    HorizontalContentAlignment="Center"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="0"
                                    Click="BtnAddCollection_Click"
                                    CornerRadius="10"
                                    Foreground="#FEFEFEFE"
                                    IconMargin="0"
                                    IconSize="14"
                                    MouseDownBackground="#3A3A3A"
                                    MouseOverBackground="#353535"
                                    ToolTip.Tip="{DynamicResource ui-addNewCollection}">
                                    <ui:CommonButton.IconTemplate>
                                        <ControlTemplate>
                                            <Viewbox Width="14" Height="14">
                                                <Canvas Width="1000" Height="1000">
                                                    <Canvas.RenderTransform>
                                                        <TransformGroup>
                                                            <ScaleTransform ScaleX="0.1" ScaleY="-0.1" />
                                                            <TranslateTransform X="0" Y="511" />
                                                        </TransformGroup>
                                                    </Canvas.RenderTransform>
                                                    <Path Data="M4553.8 4991c-1176.2-110.4-2251.6-627.8-3073.2-1472.7C889.6 2906 471 2167.7 263.7 1363.6c-395.3-1521.1-67.8-3081 906.8-4315.3c145.3-184.1 579.4-620.1 757.7-759.6c955.3-747.9 2073.4-1120 3236-1073.5c1085.1 42.6 2044.3 395.3 2906.6 1073.5c174.4 137.6 612.3 575.5 749.9 749.9c976.6 1242.1 1308 2790.3 922.3 4301.7c-168.6 658.8-474.7 1267.3-922.3 1840.8c-139.5 178.3-575.5 612.3-759.6 757.7c-773.2 610.4-1658.7 963-2645 1054.1C5173.9 5014.3 4796 5014.3 4553.8 4991z M5319.2 3772.2c1472.7-139.5 2701.2-1112.3 3166.2-2509.3c253.8-759.6 253.8-1546.3 0-2305.9c-368.2-1110.3-1222.7-1964.9-2333-2333c-759.6-253.8-1546.3-253.8-2305.9 0c-1253.7 416.6-2183.8 1463-2449.3 2759.3c-164.7 800.3-46.5 1654.8 331.4 2393.1c352.7 691.8 899.1 1242.1 1585 1594.7c389.5 201.5 811.9 335.2 1201.4 379.8c100.8 11.6 211.2 25.2 242.2 29.1C4883.2 3793.5 5115.8 3789.6 5319.2 3772.2z" Fill="{TemplateBinding Foreground}" />
                                                    <Path Data="M4896.8 2549.5c-197.7-31-377.9-170.5-465.1-362.3c-40.7-87.2-42.6-122.1-48.4-773.2l-5.8-682.1l-672.4-5.8c-786.7-7.7-796.4-9.7-974.7-188c-126-126-176.3-250-176.3-428.2c0-240.3 131.8-449.6 348.8-556.1l110.5-54.3l682.1-5.8l682.1-5.8l5.8-682.1l5.8-682.1l54.3-110.4c106.6-217 315.9-348.8 556.1-348.8c178.3 0 302.3 50.4 428.2 176.3c178.3 178.3 180.2 188 187.9 974.7l5.8 672.4l672.4 5.8c786.7 7.8 796.4 9.7 974.7 188c126 126 176.3 250 176.3 428.2c0 296.5-197.7 538.7-484.4 598.8c-62 13.6-346.9 21.3-720.8 21.3h-618.1l-5.8 684l-5.8 682.1l-54.3 110.5C5433.6 2456.5 5170 2592.1 4896.8 2549.5z" Fill="{TemplateBinding Foreground}" />
                                                </Canvas>
                                            </Viewbox>
                                        </ControlTemplate>
                                    </ui:CommonButton.IconTemplate>
                                </ui:CommonButton>
                            </Grid>

                            <!--  收藏夹列表  -->
                            <ItemsControl x:Name="CollectionList" ItemsSource="{Binding Collection}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="data:Collection">
                                        <RadioButton
                                            Classes="nav-button"
                                            Click="OnCollectionNavClick"
                                            GroupName="CollectionNav"
                                            Tag="{Binding Id}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <!--  展开: CollectionTempl 文件夹图标  -->
                                                <Viewbox
                                                    Width="18"
                                                    Height="18"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding $parent[Window].DataContext.IsNavigationCollapsed, Converter={StaticResource BoolFalseToVisibleConverter}}">
                                                    <Canvas Width="1024" Height="1024">
                                                        <Path Data="M420 181m48 0l408 0q48 0 48 48l0 0q0 48-48 48l-408 0q-48 0-48-48l0 0q0-48 48-48Z" Fill="{Binding $parent[RadioButton].Foreground}" />
                                                        <Path Data="M101 512m48 0l727 0q48 0 48 48l0 0q0 48-48 48l-727 0q-48 0-48-48l0 0q0-48 48-48Z" Fill="{Binding $parent[RadioButton].Foreground}" />
                                                        <Path Data="M101 844m48 0l727 0q48 0 48 48l0 0q0 48-48 48l-727 0q-48 0-48-48l0 0q0-48 48-48Z" Fill="{Binding $parent[RadioButton].Foreground}" />
                                                        <Path Data="M320.418 195.142c30.117 18.699 30.101 49.026 0 67.715L155.535 365.225C125.415 383.925 101 371.75 101 338.074V119.928C101 86.232 125.432 74.084 155.533 92.773l164.885 102.37z" Fill="{Binding $parent[RadioButton].Foreground}" />
                                                    </Canvas>
                                                </Viewbox>
                                                <!--  折叠: 首字母圆圈  -->
                                                <Border
                                                    Width="22"
                                                    Height="22"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Background="{Binding $parent[RadioButton].Foreground}"
                                                    CornerRadius="11"
                                                    IsVisible="{Binding $parent[Window].DataContext.IsNavigationCollapsed}">
                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        FontSize="12"
                                                        FontWeight="Bold"
                                                        Foreground="#303030"
                                                        Text="{Binding Name, Converter={StaticResource GetOutlinedTextConverter}}" />
                                                </Border>
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding $parent[Window].DataContext.IsNavigationCollapsed, Converter={StaticResource BoolFalseToVisibleConverter}}"
                                                    Text="{Binding Name}" />
                                            </StackPanel>
                                        </RadioButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!--  内容区  -->
                <Border Grid.Column="1" Background="#B0FFFFFF">
                    <ContentControl x:Name="MainFrame" />
                </Border>
            </Grid>

            <!--  播放控制栏  -->
            <controls:PlayController x:Name="PlayBarController" Grid.Row="1" />
        </Grid>
    </Grid>
</Window>
