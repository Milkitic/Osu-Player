<Window
    x:Class="OsuPlayer.Windows.ConfigWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lang="clr-namespace:OsuPlayer.Lang"
    xmlns:controls="clr-namespace:OsuPlayer.Views.UserControls"
    Title="{I18N {x:Static lang:SRKeys.Ui_Win_Sets}}"
    Icon="avares://OsuPlayer/osuPlayer.ico"
    Width="640"
    Height="440"
    MinWidth="580"
    MinHeight="400"
    CanMinimize="False"
    CanMaximize="False"
    WindowStartupLocation="CenterOwner"
    ExtendClientAreaToDecorationsHint="True"
    ExtendClientAreaTitleBarHeightHint="32"
    WindowDecorations="{OnPlatform BorderOnly,
                                   Windows=Full,
                                   x:TypeArguments=WindowDecorations}"
    WindowDecorationsTheme="{StaticResource EmptyWindowDrawnDecorationsTheme}">
    <Grid Background="#323232"
          Margin="{Binding $parent[Window].OffScreenMargin}"
          RowDefinitions="Auto,*">
        <controls:WindowTitleBar
            Grid.Row="0"
            Height="32"
            Background="#323232"
            LeftAreaMargin="8,0,0,0"
            RightAreaMargin="0,0,1,0"
            Title="{I18N {x:Static lang:SRKeys.Ui_Win_Sets}}"
            ShowMinimize="False"
            ShowMaximize="False" />

        <Grid Grid.Row="1" ColumnDefinitions="150,*">
            <Border Grid.Column="0" Background="#2B2B2B">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,0,8">
                        <Label Classes="nav-header">
                            <TextBlock Margin="5,0,0,0" Text="{I18N {x:Static lang:SRKeys.Ui_Sets}}" />
                        </Label>
                        <RadioButton x:Name="GeneralButton" Classes="nav-button settings-nav-button" Click="OnNavClick" GroupName="SettingsNav" IsChecked="True" Tag="General" Content="{I18N {x:Static lang:SRKeys.Ui_Sets_Nav_Common}}" />
                        <RadioButton x:Name="PlayButton" Classes="nav-button settings-nav-button" Click="OnNavClick" GroupName="SettingsNav" Tag="Play" Content="{I18N {x:Static lang:SRKeys.Ui_Sets_Nav_Playing}}" />
                        <RadioButton x:Name="InterfaceButton" Classes="nav-button settings-nav-button" Click="OnNavClick" GroupName="SettingsNav" Tag="Interface" Content="{I18N {x:Static lang:SRKeys.Ui_Sets_Nav_Interface}}" />
                        <RadioButton x:Name="HotKeyButton" Classes="nav-button settings-nav-button" Click="OnNavClick" GroupName="SettingsNav" Tag="HotKey" Content="{I18N {x:Static lang:SRKeys.Ui_Sets_Nav_HotKey}}" />
                        <RadioButton x:Name="LyricButton" Classes="nav-button settings-nav-button" Click="OnNavClick" GroupName="SettingsNav" Tag="Lyric" Content="{I18N {x:Static lang:SRKeys.Ui_Sets_Nav_Lyric}}" />
                        <RadioButton x:Name="ExportButton" Classes="nav-button settings-nav-button" Click="OnNavClick" GroupName="SettingsNav" Tag="Export" Content="{I18N {x:Static lang:SRKeys.Ui_Sets_Nav_Export}}" />
                        <RadioButton x:Name="AboutButton" Classes="nav-button settings-nav-button" Click="OnNavClick" GroupName="SettingsNav" Tag="About" Content="{I18N {x:Static lang:SRKeys.Ui_Sets_Nav_About}}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="1" Background="#FEFEFE">
                <Grid>
                    <Grid.Background>
                        <ImageBrush
                            Opacity="0.3"
                            Source="{StaticResource TextureSource2}"
                            Stretch="None"
                            TileMode="Tile" />
                    </Grid.Background>
                    <ContentControl x:Name="MainFrame" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
