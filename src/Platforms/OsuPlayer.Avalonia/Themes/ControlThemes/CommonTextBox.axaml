<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:OsuPlayer.Controls">

    <ControlTheme x:Key="{x:Type controls:CommonTextBox}" TargetType="controls:CommonTextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="CaretBrush" Value="#303030" />
        <Setter Property="SelectionBrush" Value="#646464" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Width" Value="100" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="White" />
        <Setter Property="Foreground" Value="#303030" />
        <Setter Property="BorderBrush" Value="#B0B0B0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </ControlTheme>

</ResourceDictionary>
