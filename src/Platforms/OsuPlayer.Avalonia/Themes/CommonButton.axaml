<Styles
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:OsuPlayer.Controls">
  <!--  设计时预览区域  -->
  <Design.PreviewWith>
    <Border Padding="50">
      <StackPanel>
        <!--  标准样式按钮预览  -->
        <controls:CommonButton
          Margin="5"
          Padding="3"
          Content="SB">
          <controls:CommonButton.IconTemplate>
            <ControlTemplate>
              <Border Width="100" Height="100">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0" Color="#4278F0" />
                    <GradientStop Offset="1" Color="#42c032" />
                  </LinearGradientBrush>
                </Border.Background>
              </Border>
            </ControlTemplate>
          </controls:CommonButton.IconTemplate>
        </controls:CommonButton>
        <!--  简单样式按钮预览  -->
        <controls:CommonButton
          Padding="3"
          Content="SB"
          Theme="{StaticResource SimpleCommonButtonTheme}">
          <controls:CommonButton.IconTemplate>
            <ControlTemplate>
              <Border Width="100" Height="100">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0" Color="#4278F0" />
                    <GradientStop Offset="1" Color="#42c032" />
                  </LinearGradientBrush>
                </Border.Background>
              </Border>
            </ControlTemplate>
          </controls:CommonButton.IconTemplate>
        </controls:CommonButton>
      </StackPanel>

    </Border>
  </Design.PreviewWith>

  <Styles.Resources>
    <!--  CommonButton主题定义  -->
    <ControlTheme x:Key="{x:Type controls:CommonButton}" TargetType="controls:CommonButton">
      <!--  基本属性设置  -->
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="#f0f0f0" />
      <Setter Property="BorderBrush" Value="#f0f0f0" />
      <Setter Property="Foreground" Value="#484848" />
      <Setter Property="BorderThickness" Value="1,0" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Height" Value="36" />
      <!--  鼠标交互状态样式定义  -->
      <Setter Property="MouseOverBackground" Value="#f3f5f5" />
      <Setter Property="MouseOverForeground" Value="#484848" />
      <Setter Property="MouseDownBackground" Value="#e8e8e8" />
      <Setter Property="MouseDownForeground" Value="#323232" />
      <Setter Property="CornerRadius" Value="2" />
      <!--  按钮模板定义  -->
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type controls:CommonButton}">
            <!--  主边框  -->
            <Border
              x:Name="BorderMain"
              Width="{TemplateBinding Width}"
              Height="{TemplateBinding Height}"
              Padding="{TemplateBinding Padding}"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              CornerRadius="{TemplateBinding CornerRadius}">
              <!--  内容排列区域  -->
              <StackPanel
                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                Orientation="{TemplateBinding IconOrientation}">
                <!--  图标区域  -->
                <Viewbox
                  x:Name="IconViewBox"
                  Width="{TemplateBinding IconSize}"
                  Height="{TemplateBinding IconSize}"
                  Margin="{TemplateBinding IconMargin}"
                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                  IsVisible="False"
                  UseLayoutRounding="True">
                  <ContentControl x:Name="IconContent" Template="{TemplateBinding IconTemplate}" />
                </Viewbox>
                <!--  文本内容区域  -->
                <ContentPresenter
                  x:Name="PART_ContentPresenter"
                  HorizontalAlignment="Center"
                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                  Content="{TemplateBinding Content}"
                  ContentTemplate="{TemplateBinding ContentTemplate}"
                  RecognizesAccessKey="True" />
              </StackPanel>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>

      <!--  鼠标悬停样式  -->
      <Style Selector="^:pointerover /template/ Border#BorderMain">
        <Setter Property="Background" Value="{Binding MouseOverBackground, RelativeSource={RelativeSource TemplatedParent}}" />
        <Setter Property="TextBlock.Foreground" Value="{Binding MouseOverForeground, RelativeSource={RelativeSource TemplatedParent}}" />
      </Style>

      <!--  鼠标按下样式  -->
      <Style Selector="^:pressed /template/ Border#BorderMain">
        <Setter Property="Background" Value="{Binding MouseDownBackground, RelativeSource={RelativeSource TemplatedParent}}" />
        <Setter Property="TextBlock.Foreground" Value="{Binding MouseDownForeground, RelativeSource={RelativeSource TemplatedParent}}" />
      </Style>

      <!--  禁用状态样式  -->
      <Style Selector="^:disabled /template/ Border#BorderMain">
        <Setter Property="Opacity" Value="0.5" />
      </Style>

      <!--  有图标时的样式  -->
      <Style Selector="^:icon /template/ Viewbox#IconViewBox">
        <Setter Property="IsVisible" Value="True" />
      </Style>
    </ControlTheme>

    <!--  简单CommonButton主题（基于标准CommonButton主题）  -->
    <ControlTheme
      x:Key="SimpleCommonButtonTheme"
      BasedOn="{StaticResource {x:Type controls:CommonButton}}"
      TargetType="controls:CommonButton" />

  </Styles.Resources>

</Styles>
