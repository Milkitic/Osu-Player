<UserControl
    x:Class="OsuPlayer.Views.Pages.CollectionPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:OsuPlayer.ViewModels"
    x:DataType="vm:CollectionPageViewModel">
    <Grid RowDefinitions="Auto,*">
        <StackPanel
            Grid.Row="0"
            Margin="10"
            Orientation="Horizontal"
            Spacing="8">
            <Button Classes="style-collection" Content="Play All" />
            <Button Classes="style-collection" Content="Export" />
            <Button Classes="style-collection" Content="Save" />
        </StackPanel>
        <ListBox
            Grid.Row="1"
            Margin="10"
            Background="Transparent"
            ItemsSource="{Binding Beatmaps}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="40,*,*,*,*">
                        <TextBlock
                            Grid.Column="0"
                            Foreground="#FF9C9C9C"
                            Text="{Binding Index}" />
                        <TextBlock
                            Grid.Column="1"
                            Foreground="White"
                            Text="{Binding AutoTitle}" />
                        <TextBlock
                            Grid.Column="2"
                            Foreground="#FF9C9C9C"
                            Text="{Binding AutoArtist}" />
                        <TextBlock
                            Grid.Column="3"
                            Foreground="White"
                            Text="{Binding AutoCreator}" />
                        <TextBlock
                            Grid.Column="4"
                            Foreground="#FF9C9C9C"
                            Text="{Binding AutoVersion}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
