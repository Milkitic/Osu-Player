<UserControl
    x:Class="OsuPlayer.Views.Pages.CollectionPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:OsuPlayer.ViewModels"
    x:DataType="vm:CollectionPageViewModel">
    <UserControl.Styles>
        <Style Selector="ListBox.collection-list > ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,1" />
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="Auto,Auto,Auto,*">
        <Border
            Grid.Row="0"
            Margin="5"
            Padding="10"
            Background="#EAF9F7F8"
            BorderBrush="#20DAA3CE"
            BorderThickness="1"
            CornerRadius="10">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Grid
                    Grid.Column="0"
                    Width="192"
                    Height="192"
                    Margin="10"
                    Background="#F0F0F0">
                    <Image
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Source="{Binding CollectionInfo.ImagePath}"
                        Stretch="UniformToFill" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="24"
                        Foreground="#CCC"
                        Text="🖼" />
                </Grid>
                <StackPanel Grid.Column="1" Margin="10,0" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="#303030"
                            Text="{Binding CollectionInfo.Name}" />
                        <Button
                            Width="24"
                            Height="24"
                            Classes="settings-button"
                            Command="{Binding EditCollectionCommand}"
                            Content="✎" />
                        <Button
                            Width="24"
                            Height="24"
                            Classes="settings-button"
                            Command="{Binding DeleteCollectionCommand}"
                            Content="✕" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Foreground="#303030" Text="{DynamicResource ui-createTime}" />
                        <TextBlock Foreground="#606060" Text="{Binding CollectionInfo.CreateTime, StringFormat=\{0:yyyy-MM-dd\}}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button
                            Classes="play-button"
                            Command="{Binding PlayAllCommand}"
                            Content="{DynamicResource ui-btn-playAll}" />
                        <Button
                            Classes="settings-button"
                            Command="{Binding ExportAllCommand}"
                            Content="{DynamicResource ui-btn-exportAll}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Foreground="#303030" Text="{DynamicResource ui-briefIntroduction}" />
                        <TextBlock Foreground="#606060" Text="{Binding CollectionInfo.Description}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="10" Spacing="0">
                    <TextBlock
                        HorizontalAlignment="Right"
                        Foreground="#7A7A7A"
                        Text="{DynamicResource ui-musicCount}" />
                    <TextBlock
                        HorizontalAlignment="Right"
                        FontWeight="Bold"
                        Foreground="#7A7A7A"
                        Text="{Binding Beatmaps.Count}" />
                </StackPanel>
            </Grid>
        </Border>
        <TextBox
            Grid.Row="1"
            Width="180"
            HorizontalAlignment="Right"
            Margin="0,5,10,0"
            Background="White"
            BorderBrush="#DCDFE6"
            BorderThickness="1"
            PlaceholderText="{DynamicResource ui-hint-searchCollectionMusic3Dot}"
            Text="{Binding SearchText}" />
        <Border
            Grid.Row="2"
            Margin="5,10,5,0"
            Padding="12,8"
            Background="#F4F5F7"
            BorderBrush="#E4E6EB"
            BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="40,3*,2*,*,2*">
                <TextBlock FontWeight="SemiBold" Foreground="#666666" Text="#" />
                <TextBlock Grid.Column="1" FontWeight="SemiBold" Foreground="#666666" Text="{DynamicResource ui-title}" />
                <TextBlock Grid.Column="2" FontWeight="SemiBold" Foreground="#666666" Text="{DynamicResource ui-artist}" />
                <TextBlock Grid.Column="3" FontWeight="SemiBold" Foreground="#666666" Text="{DynamicResource ui-creator}" />
                <TextBlock Grid.Column="4" FontWeight="SemiBold" Foreground="#666666" Text="{DynamicResource ui-mapDifficulty}" />
            </Grid>
        </Border>
        <ListBox
            Grid.Row="3"
            Classes="collection-list"
            Margin="5,0,5,5"
            Background="Transparent"
            ItemsSource="{Binding DisplayedBeatmaps}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="12,10" Background="#FBFBFB" BorderBrush="#E6E6E6" BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="40,3*,2*,*,2*">
                            <TextBlock
                                Grid.Column="0"
                                Foreground="#9C9C9C"
                                Text="{Binding Index}" />
                            <TextBlock
                                Grid.Column="1"
                                Foreground="#222222"
                                Text="{Binding AutoTitle}" />
                            <TextBlock
                                Grid.Column="2"
                                Foreground="#9C9C9C"
                                Text="{Binding AutoArtist}" />
                            <TextBlock
                                Grid.Column="3"
                                Foreground="#222222"
                                Text="{Binding AutoCreator}" />
                            <TextBlock
                                Grid.Column="4"
                                Foreground="#9C9C9C"
                                Text="{Binding AutoVersion}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
