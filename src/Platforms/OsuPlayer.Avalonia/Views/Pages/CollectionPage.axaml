<UserControl
    x:Class="OsuPlayer.Views.Pages.CollectionPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:OsuPlayer.ViewModels"
    x:DataType="vm:CollectionPageViewModel">
    <Grid RowDefinitions="Auto,Auto,*">
        <Border
            Grid.Row="0"
            Margin="5"
            Padding="10"
            Background="#EAF9F7F8"
            BorderBrush="#20DAA3CE"
            BorderThickness="1"
            CornerRadius="10">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Border
                    Grid.Column="0"
                    Width="120"
                    Height="120"
                    Margin="0,0,10,0"
                    Background="#F0F0F0"
                    CornerRadius="4">
                    <!-- TODO: D-phase — load Bitmap from CollectionInfo.ImagePath file path -->
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="24"
                        Foreground="#CCC"
                        Text="🖼" />
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="#303030"
                            Text="{Binding CollectionInfo.Name}" />
                        <Button
                            Width="24"
                            Height="24"
                            Classes="style-collection"
                            Command="{Binding EditCollectionCommand}"
                            Content="✎" />
                        <Button
                            Width="24"
                            Height="24"
                            Classes="style-collection"
                            Command="{Binding DeleteCollectionCommand}"
                            Content="✕" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Foreground="#303030" Text="{DynamicResource ui-createTime}" />
                        <TextBlock Foreground="#606060" Text="{Binding CollectionInfo.CreateTime, StringFormat=\{0:yyyy-MM-dd\}}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button
                            Classes="style-collection"
                            Command="{Binding PlayAllCommand}"
                            Content="{DynamicResource ui-btn-playAll}" />
                        <Button
                            Classes="style-collection"
                            Command="{Binding ExportAllCommand}"
                            Content="{DynamicResource ui-btn-exportAll}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Foreground="#303030" Text="{DynamicResource ui-briefIntroduction}" />
                        <TextBlock Foreground="#606060" Text="{Binding CollectionInfo.Description}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="10" Spacing="0">
                    <TextBlock
                        HorizontalAlignment="Right"
                        Foreground="#7A7A7A"
                        Text="{DynamicResource ui-musicCount}" />
                    <TextBlock
                        HorizontalAlignment="Right"
                        FontWeight="Bold"
                        Foreground="#7A7A7A"
                        Text="{Binding Beatmaps.Count}" />
                </StackPanel>
            </Grid>
        </Border>
        <TextBox
            Grid.Row="1"
            Width="180"
            HorizontalAlignment="Right"
            Margin="0,5,10,0"
            PlaceholderText="{DynamicResource ui-hint-searchCollectionMusic3Dot}"
            Text="{Binding SearchText}" />
        <ListBox
            Grid.Row="2"
            Margin="5,0"
            Background="Transparent"
            ItemsSource="{Binding DisplayedBeatmaps}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="40,*,2*,*,2*">
                        <TextBlock
                            Grid.Column="0"
                            Foreground="#9C9C9C"
                            Text="{Binding Index}" />
                        <TextBlock
                            Grid.Column="1"
                            Foreground="#222222"
                            Text="{Binding AutoTitle}" />
                        <TextBlock
                            Grid.Column="2"
                            Foreground="#9C9C9C"
                            Text="{Binding AutoArtist}" />
                        <TextBlock
                            Grid.Column="3"
                            Foreground="#222222"
                            Text="{Binding AutoCreator}" />
                        <TextBlock
                            Grid.Column="4"
                            Foreground="#9C9C9C"
                            Text="{Binding AutoVersion}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>