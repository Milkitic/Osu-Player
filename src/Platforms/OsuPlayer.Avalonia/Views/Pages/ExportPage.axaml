<UserControl
    x:Class="OsuPlayer.Views.Pages.ExportPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:OsuPlayer.ViewModels"
    x:DataType="vm:ExportPageViewModel">
    <UserControl.Styles>
        <Style Selector="ListBox.export-list > ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,1" />
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="Auto,Auto,*">
        <StackPanel
            Grid.Row="0"
            Margin="10"
            Orientation="Horizontal"
            Spacing="8">
            <Button
                Classes="settings-button"
                Command="{Binding ItemFolderCommand}"
                Content="{DynamicResource ui-btn-openDirectory}" />
            <TextBlock
                VerticalAlignment="Center"
                Foreground="#606060"
                Text="{DynamicResource ui-exportPath}" />
            <TextBlock
                VerticalAlignment="Center"
                Foreground="#222222"
                Text="{Binding ExportPath}" />
        </StackPanel>
        <Border
            Grid.Row="1"
            Margin="5,0,5,0"
            Padding="12,8"
            Background="#F4F5F7"
            BorderBrush="#E4E6EB"
            BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="40,3*,2*,*,*">
                <TextBlock FontWeight="SemiBold" Foreground="#666666" Text="#" />
                <TextBlock Grid.Column="1" FontWeight="SemiBold" Foreground="#666666" Text="{DynamicResource ui-title}" />
                <TextBlock Grid.Column="2" FontWeight="SemiBold" Foreground="#666666" Text="{DynamicResource ui-artist}" />
                <TextBlock Grid.Column="3" FontWeight="SemiBold" Foreground="#666666" Text="Size" />
                <TextBlock Grid.Column="4" FontWeight="SemiBold" Foreground="#666666" Text="Time" />
            </Grid>
        </Border>
        <ListBox
            Grid.Row="2"
            Classes="export-list"
            Margin="5,0,5,5"
            Background="Transparent"
            ItemsSource="{Binding DataModelList}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="12,10" Background="#FBFBFB" BorderBrush="#E6E6E6" BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="40,3*,2*,*,*">
                            <TextBlock
                                Grid.Column="0"
                                Foreground="#9C9C9C"
                                Text="{Binding Index}" />
                            <TextBlock
                                Grid.Column="1"
                                Foreground="#222222"
                                Text="{Binding AutoTitle}" />
                            <TextBlock
                                Grid.Column="2"
                                Foreground="#9C9C9C"
                                Text="{Binding AutoArtist}" />
                            <TextBlock
                                Grid.Column="3"
                                Foreground="#9C9C9C"
                                Text="{Binding FileSize}" />
                            <TextBlock
                                Grid.Column="4"
                                Foreground="#222222"
                                Text="{Binding ExportTime}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
