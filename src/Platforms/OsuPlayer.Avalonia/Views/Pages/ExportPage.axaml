<UserControl
    x:Class="OsuPlayer.Views.Pages.ExportPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:OsuPlayer.ViewModels"
    x:DataType="vm:ExportPageViewModel">
    <Grid RowDefinitions="Auto,*">
        <StackPanel
            Grid.Row="0"
            Margin="10"
            Orientation="Horizontal"
            Spacing="8">
            <Button
                Classes="style-collection"
                Command="{Binding ItemFolderCommand}"
                Content="{DynamicResource ui-btn-openDirectory}" />
            <TextBlock
                VerticalAlignment="Center"
                Foreground="#606060"
                Text="{DynamicResource ui-exportPath}" />
            <TextBlock
                VerticalAlignment="Center"
                Foreground="#222222"
                Text="{Binding ExportPath}" />
        </StackPanel>
        <ListBox
            Grid.Row="1"
            Margin="5,0"
            Background="Transparent"
            ItemsSource="{Binding DataModelList}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="40,*,2*,*,2*">
                        <TextBlock
                            Grid.Column="0"
                            Foreground="#9C9C9C"
                            Text="{Binding Index}" />
                        <TextBlock
                            Grid.Column="1"
                            Foreground="#222222"
                            Text="{Binding AutoTitle}" />
                        <TextBlock
                            Grid.Column="2"
                            Foreground="#9C9C9C"
                            Text="{Binding AutoArtist}" />
                        <TextBlock
                            Grid.Column="3"
                            Foreground="#9C9C9C"
                            Text="{Binding FileSize}" />
                        <TextBlock
                            Grid.Column="4"
                            Foreground="#222222"
                            Text="{Binding ExportTime}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>