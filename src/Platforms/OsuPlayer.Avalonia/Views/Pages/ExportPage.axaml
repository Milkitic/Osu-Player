<UserControl
    x:Class="OsuPlayer.Views.Pages.ExportPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:OsuPlayer.ViewModels"
    x:DataType="vm:ExportPageViewModel">
    <Grid>
        <ListBox
            Margin="10"
            Background="Transparent"
            ItemsSource="{Binding Exports}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="*,2*,2*,*">
                        <TextBlock
                            Grid.Column="0"
                            Foreground="White"
                            Text="{Binding AutoTitle}" />
                        <TextBlock
                            Grid.Column="1"
                            FontSize="11"
                            Foreground="#AAAAAA"
                            Text="{Binding ExportFile}" />
                        <TextBlock
                            Grid.Column="2"
                            FontSize="11"
                            Foreground="#AAAAAA"
                            Text="{Binding ExportTime}" />
                        <TextBlock
                            Grid.Column="3"
                            FontSize="11"
                            Foreground="#AAAAAA"
                            Text="{Binding FileSize}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
