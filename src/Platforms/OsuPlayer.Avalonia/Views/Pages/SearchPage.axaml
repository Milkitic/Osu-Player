<UserControl
    x:Class="OsuPlayer.Views.Pages.SearchPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:OsuPlayer.ViewModels"
    x:DataType="vm:SearchPageViewModel">
    <Grid RowDefinitions="Auto,Auto,*">
        <TextBox
            Grid.Row="0"
            Margin="10"
            PlaceholderText="{DynamicResource ui-hint-searchPageBox}"
            Text="{Binding SearchText}" />
        <StackPanel
            Grid.Row="1"
            Margin="10,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="8">
            <Button
                Classes="style-collection"
                Command="{Binding PlayAllCommand}"
                Content="{DynamicResource ui-btn-playAll}" />
            <Button
                Classes="style-collection"
                Command="{Binding SearchCommand}"
                Content="{DynamicResource ui-btn-queueAll}" />
        </StackPanel>
        <ListBox
            Grid.Row="2"
            Margin="5,0"
            Background="Transparent"
            ItemsSource="{Binding DisplayedMaps}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock
                            FontWeight="SemiBold"
                            Foreground="#222222"
                            Text="{Binding AutoTitle}" />
                        <TextBlock
                            FontSize="12"
                            Foreground="#9C9C9C"
                            Text="{Binding AutoArtist}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>