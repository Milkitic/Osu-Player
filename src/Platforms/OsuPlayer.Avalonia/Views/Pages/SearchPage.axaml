<UserControl
    x:Class="OsuPlayer.Views.Pages.SearchPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:OsuPlayer.ViewModels"
    x:DataType="vm:SearchPageViewModel">
    <Grid RowDefinitions="Auto,Auto,*">
        <TextBox
            Grid.Row="0"
            Margin="10"
            PlaceholderText="Search..."
            Text="{Binding SearchText, Mode=TwoWay}" />
        <Button
            Grid.Row="1"
            Margin="10,0"
            HorizontalAlignment="Left"
            Classes="style-collection"
            Command="{Binding SearchCommand}"
            Content="Search" />
        <ListBox
            Grid.Row="2"
            Margin="10"
            Background="Transparent"
            ItemsSource="{Binding Results}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock
                            FontWeight="Bold"
                            Foreground="White"
                            Text="{Binding Title}" />
                        <TextBlock
                            FontSize="11"
                            Foreground="#AAAAAA"
                            Text="{Binding Artist}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
