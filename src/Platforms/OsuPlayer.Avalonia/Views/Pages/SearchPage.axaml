<UserControl
    x:Class="OsuPlayer.Views.Pages.SearchPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="clr-namespace:OsuPlayer.Core;assembly=OsuPlayer.Core"
    xmlns:lang="clr-namespace:OsuPlayer.Lang"
    xmlns:panelComponent="clr-namespace:OsuPlayer.Controls.PanelComponent"
    xmlns:ui="clr-namespace:OsuPlayer.Controls"
    xmlns:userControls="clr-namespace:OsuPlayer.Views.UserControls"
    xmlns:vm="clr-namespace:OsuPlayer.ViewModels"
    x:Name="Root"
    x:DataType="vm:SearchPageViewModel">
    <UserControl.Styles>
        <Style Selector="ui|CommonButton.search-settings">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#DADADB" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="Height" Value="28" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="IconSize" Value="15" />
            <Setter Property="IconMargin" Value="0,0,5,0" />
            <Setter Property="Background" Value="#FAFAFB" />
            <Setter Property="Foreground" Value="#484848" />
            <Setter Property="MouseOverBackground" Value="#F0F0F0" />
            <Setter Property="MouseOverForeground" Value="#484848" />
            <Setter Property="MouseDownBackground" Value="#E8E8E8" />
            <Setter Property="MouseDownForeground" Value="#323232" />
        </Style>
        <Style Selector="ui|CommonButton.search-play">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="#5D9CEC" />
            <Setter Property="Content" Value="{I18N {x:Static lang:SRKeys.Ui_Btn_PlayAll}}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="IconTemplate" Value="{StaticResource SettingsPlayTempl}" />
            <Setter Property="IconSize" Value="18" />
            <Setter Property="IconMargin" Value="-5,0,5,0" />
            <Setter Property="Background" Value="#5D9CEC" />
            <Setter Property="MouseDownBackground" Value="#4D8CDC" />
            <Setter Property="MouseDownForeground" Value="#E8E8E8" />
            <Setter Property="MouseOverBackground" Value="#6DA3EF" />
            <Setter Property="MouseOverForeground" Value="White" />
        </Style>
        <Style Selector="Button.search-page-button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="MinWidth" Value="26" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#D0D0D0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="1" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <TextBox
            Grid.Row="0"
            Height="40"
            Margin="30,20,30,20"
            Padding="10,0"
            VerticalAlignment="Top"
            VerticalContentAlignment="Center"
            Background="White"
            BorderBrush="#DDDDDD"
            BorderThickness="1"
            CornerRadius="0"
            Cursor="IBeam"
            FontSize="14"
            Foreground="#555555"
            PlaceholderText="{I18N {x:Static lang:SRKeys.Ui_Hint_SearchPageBox}}"
            Text="{Binding SearchText, Mode=TwoWay}" />

        <StackPanel
            Grid.Row="1"
            Margin="10,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="0">
            <ui:CommonButton Classes="search-settings search-play" Command="{Binding PlayAllCommand}" />
            <ui:CommonButton
                Classes="search-settings"
                Command="{Binding QueueAllCommand}"
                Content="{I18N {x:Static lang:SRKeys.Ui_Btn_QueueAll}}"
                IconTemplate="{StaticResource FolderTempl}" />
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid
                Margin="0,20,0,2"
                IsVisible="{Binding IsMinimalMode, Converter={StaticResource BoolTrueToVisibleConverter}}"
                RowDefinitions="Auto,*">
                <Border
                    Height="28"
                    Background="#F7F7F7"
                    BorderBrush="#E6E6E6"
                    BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="300,200,100,*">
                        <TextBlock
                            Margin="15,0,0,0"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Foreground="#666666"
                            Text="{I18N {x:Static lang:SRKeys.Ui_Title}}" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Foreground="#666666"
                            Text="{I18N {x:Static lang:SRKeys.Ui_Artist}}" />
                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Foreground="#666666"
                            Text="{I18N {x:Static lang:SRKeys.Ui_Creator}}" />
                    </Grid>
                </Border>
                <ListBox
                    x:Name="ResultList"
                    Grid.Row="1"
                    Classes="beatmap-results"
                    DoubleTapped="ResultList_DoubleTapped"
                    ItemsSource="{Binding DisplayedMaps}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="core:BeatmapDataModel">
                            <Border
                                Margin="2,0,2,-1"
                                Background="#80FFFFFF"
                                BorderBrush="#20303030"
                                BorderThickness="1"
                                Classes="beatmap-list-row"
                                CornerRadius="3">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Click="PlayWithDifficulty_Click" Tag="{Binding}">
                                            <MenuItem.Header>
                                                <TextBlock><Run Text="{I18N {x:Static lang:SRKeys.Ui_Play}}" /><Run Text="... (Enter)" /></TextBlock>
                                            </MenuItem.Header>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem
                                            Click="SearchByCondition_Click"
                                            CommandParameter="Title"
                                            Header="{I18N {x:Static lang:SRKeys.Ui_CtxMenu_SearchTitle}}"
                                            Tag="{Binding}" />
                                        <MenuItem
                                            Click="SearchByCondition_Click"
                                            CommandParameter="Artist"
                                            Header="{I18N {x:Static lang:SRKeys.Ui_CtxMenu_SearchArtist}}"
                                            Tag="{Binding}" />
                                        <MenuItem
                                            Click="SearchByCondition_Click"
                                            CommandParameter="Source"
                                            Header="{I18N {x:Static lang:SRKeys.Ui_CtxMenu_SearchSource}}"
                                            Tag="{Binding}" />
                                        <MenuItem
                                            Click="SearchByCondition_Click"
                                            CommandParameter="Creator"
                                            Header="{I18N {x:Static lang:SRKeys.Ui_CtxMenu_SearchCreator}}"
                                            Tag="{Binding}" />
                                        <Separator />
                                        <MenuItem Click="OpenFolder_Click" Tag="{Binding}">
                                            <MenuItem.Header>
                                                <TextBlock><Run Text="{I18N {x:Static lang:SRKeys.Ui_CtxMenu_OpenSourceFolder}}" /><Run Text=" (Ctrl+O)" /></TextBlock>
                                            </MenuItem.Header>
                                        </MenuItem>
                                        <MenuItem
                                            Click="OpenScorePage_Click"
                                            Header="{I18N {x:Static lang:SRKeys.Ui_CtxMenu_OpenScorePage}}"
                                            Tag="{Binding}" />
                                        <Separator />
                                        <MenuItem Click="SaveCollection_Click" Tag="{Binding}">
                                            <MenuItem.Header>
                                                <TextBlock><Run Text="{I18N {x:Static lang:SRKeys.Ui_CtxMenu_SaveTo}}" /><Run Text="... (Ctrl+S)" /></TextBlock>
                                            </MenuItem.Header>
                                        </MenuItem>
                                        <MenuItem
                                            Click="ExportCard_Click"
                                            Header="{I18N {x:Static lang:SRKeys.Ui_CtxMenu_Export}}"
                                            Tag="{Binding}" />
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid ColumnDefinitions="300,200,100,*">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock
                                            Margin="15,7,0,0"
                                            Foreground="#303030"
                                            Text="{Binding AutoTitle}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Margin="25,-2,0,7"
                                            FontStyle="Italic"
                                            Foreground="#9C9C9C"
                                            Text="{Binding SongSource}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Foreground="#9C9C9C"
                                        Text="{Binding AutoArtist}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Foreground="#484848"
                                        Text="{Binding AutoCreator}"
                                        TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <ListBox
                x:Name="ResultCardList"
                Classes="beatmap-card-list"
                IsVisible="{Binding IsMinimalMode, Converter={StaticResource BoolFalseToVisibleConverter}}"
                ItemsSource="{Binding DisplayedMaps}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <panelComponent:VirtualizingGalleryWrapPanel
                            ChildHeight="220"
                            ChildWidth="160"
                            ItemLoaded="VirtualizingGalleryWrapPanel_OnItemLoaded"
                            Loaded="Panel_Loaded"
                            ScrollOffset="100" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate x:CompileBindings="False" x:DataType="core:BeatmapDataModel">
                        <userControls:BeatmapCard
                            DirectPlayCommand="{Binding $parent[UserControl].DataContext.DirectPlayCommand}"
                            ExportCommand="{Binding $parent[UserControl].DataContext.ExportCommand}"
                            OpenScorePageCommand="{Binding $parent[UserControl].DataContext.OpenScorePageCommand}"
                            OpenSourceFolderCommand="{Binding $parent[UserControl].DataContext.OpenSourceFolderCommand}"
                            PlayCommand="{Binding $parent[UserControl].DataContext.PlayCommand}"
                            SaveCollectionCommand="{Binding $parent[UserControl].DataContext.SaveCollectionCommand}"
                            SearchByConditionCommand="{Binding $parent[UserControl].DataContext.SearchByConditionCommand}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <StackPanel
            Grid.Row="3"
            Margin="10"
            HorizontalAlignment="Center"
            Orientation="Horizontal"
            Spacing="0">
            <Button Classes="flat-button search-page-button" Click="PreviousPage_Click">
                <Viewbox Width="12" Height="12">
                    <ContentControl Template="{StaticResource PageArrowLeftControl}" />
                </Viewbox>
            </Button>
            <ItemsControl ItemsSource="{Binding Pages}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ListPageViewModel">
                        <Grid>
                            <Border
                                Width="26"
                                Height="26"
                                Margin="2"
                                Background="{Binding IsActivated, Converter={StaticResource ButtonColorConverter}}"
                                BorderBrush="#D0D0D0"
                                BorderThickness="1"
                                CornerRadius="1"
                                IsVisible="{Binding IsActivated}" />
                            <Button
                                Classes="flat-button search-page-button"
                                Click="PageBtn_Click"
                                IsEnabled="{Binding IsActivated, Converter={StaticResource NegativeBooleanConverter}}"
                                Tag="{Binding Index}">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="#646464"
                                    Text="{Binding Index}" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Classes="flat-button search-page-button" Click="NextPage_Click">
                <Viewbox Width="12" Height="12">
                    <ContentControl Template="{StaticResource PageArrowRightControl}" />
                </Viewbox>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
