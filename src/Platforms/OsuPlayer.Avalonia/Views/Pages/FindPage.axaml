<UserControl
    x:Class="OsuPlayer.Views.Pages.FindPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Panel>
        <TextBlock
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontSize="24"
            Foreground="#AAA"
            Text="{DynamicResource ui-nav-storyboard}" />
    </Panel>
</UserControl>