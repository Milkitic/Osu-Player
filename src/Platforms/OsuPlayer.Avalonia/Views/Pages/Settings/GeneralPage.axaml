<UserControl
    x:Class="OsuPlayer.Views.Pages.Settings.GeneralPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:OsuPlayer.ViewModels.Pages.Settings"
    Classes="settings-page"
    x:DataType="vm:GeneralPageViewModel">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10" Spacing="6">
            <TextBlock Classes="config-title" Text="{DynamicResource ui-sets-title-startup}" />
            <CheckBox
                Classes="config-check"
                HorizontalAlignment="Left"
                Content="{DynamicResource ui-sets-content-runOnStartup}"
                IsChecked="{Binding RunOnStartup, Mode=TwoWay}" />

            <TextBlock Classes="config-title" Text="{DynamicResource ui-sets-title-osuDbLocation}" />
            <StackPanel Classes="config-row" Orientation="Horizontal">
                <TextBox
                    Classes="config-box"
                    Width="250"
                    Height="27"
                    IsReadOnly="True"
                    Text="{Binding DbPath, Mode=OneWay}" />
                <Button
                    Classes="settings-button"
                    Width="27"
                    Height="27"
                    Command="{Binding BrowseDbCommand}"
                    Content="..." />
                <Button
                    Classes="settings-button"
                    Command="{Binding SyncNowCommand}"
                    Content="{DynamicResource ui-btn-syncManually}" />
            </StackPanel>

            <TextBlock Classes="config-title" Text="{DynamicResource ui-sets-title-customSongPath}" />
            <StackPanel Classes="config-row" Orientation="Horizontal">
                <TextBox
                    Classes="config-box"
                    Width="250"
                    Height="27"
                    IsReadOnly="True"
                    Text="{Binding CustomSongsPath, Mode=OneWay}" />
                <Button
                    Classes="settings-button"
                    Width="27"
                    Height="27"
                    Command="{Binding BrowseCustomCommand}"
                    Content="..." />
                <Button
                    Classes="settings-button"
                    Command="{Binding ScanNowCommand}"
                    Content="{DynamicResource ui-btn-scanManually}"
                    IsVisible="{Binding !IsScanning}" />
                <TextBlock
                    Classes="config-label"
                    VerticalAlignment="Center"
                    IsVisible="{Binding IsScanning}"
                    Text="{DynamicResource ui-sets-content-scanning3Dot}" />
                <Button
                    Classes="link-button"
                    Command="{Binding CancelScanCommand}"
                    Content="{DynamicResource ui-btn-cancelScan}"
                    IsVisible="{Binding IsScanning}" />
            </StackPanel>

            <TextBlock Classes="config-title" Text="{DynamicResource ui-sets-title-closeWindow}" />
            <RadioButton
                Classes="config-radio"
                HorizontalAlignment="Left"
                Content="{DynamicResource ui-sets-content-minToNotificationPanel}"
                GroupName="close"
                IsChecked="{Binding IsMinimizeWhenClosed, Mode=TwoWay}" />
            <RadioButton
                Classes="config-radio"
                HorizontalAlignment="Left"
                Content="{DynamicResource ui-sets-content-exitProgram}"
                GroupName="close"
                IsChecked="{Binding IsExitWhenClosed, Mode=TwoWay}" />
            <CheckBox
                Classes="config-check"
                Margin="8,10,0,0"
                HorizontalAlignment="Left"
                Content="{DynamicResource ui-sets-content-setAsDefaultOptions}"
                IsChecked="{Binding SetAsDefaultOptions, Mode=TwoWay}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
