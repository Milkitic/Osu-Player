<UserControl
    x:Class="OsuPlayer.Views.Pages.Settings.GeneralPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:OsuPlayer.ViewModels.Pages.Settings"
    x:DataType="vm:GeneralPageViewModel">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10" Spacing="6">
            <TextBlock
                FontWeight="SemiBold"
                Foreground="#222222"
                Margin="5,15,0,10"
                Text="{DynamicResource ui-sets-title-startup}" />
            <CheckBox
                Margin="8,0"
                HorizontalAlignment="Left"
                Content="{DynamicResource ui-sets-content-runOnStartup}"
                IsChecked="{Binding RunOnStartup, Mode=TwoWay}" />

            <TextBlock
                FontWeight="SemiBold"
                Foreground="#222222"
                Margin="5,15,0,10"
                Text="{DynamicResource ui-sets-title-osuDbLocation}" />
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBox
                    Width="250"
                    Height="27"
                    IsReadOnly="True"
                    Text="{Binding DbPath, Mode=OneWay}" />
                <Button
                    Width="27"
                    Height="27"
                    Classes="style-collection"
                    Command="{Binding BrowseDbCommand}"
                    Content="..." />
                <Button
                    Classes="style-collection"
                    Command="{Binding SyncNowCommand}"
                    Content="{DynamicResource ui-btn-syncManually}" />
            </StackPanel>

            <TextBlock
                FontWeight="SemiBold"
                Foreground="#222222"
                Margin="5,15,0,10"
                Text="{DynamicResource ui-sets-title-customSongPath}" />
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBox
                    Width="250"
                    Height="27"
                    IsReadOnly="True"
                    Text="{Binding CustomSongsPath, Mode=OneWay}" />
                <Button
                    Width="27"
                    Height="27"
                    Classes="style-collection"
                    Command="{Binding BrowseCustomCommand}"
                    Content="..." />
                <Button
                    Classes="style-collection"
                    Command="{Binding ScanNowCommand}"
                    Content="{DynamicResource ui-btn-scanManually}"
                    IsVisible="{Binding !IsScanning}" />
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="#606060"
                    IsVisible="{Binding IsScanning}"
                    Text="{DynamicResource ui-sets-content-scanning3Dot}" />
                <Button
                    Classes="style-image"
                    Command="{Binding CancelScanCommand}"
                    Content="{DynamicResource ui-btn-cancelScan}"
                    Foreground="#5472FE"
                    IsVisible="{Binding IsScanning}" />
            </StackPanel>

            <TextBlock
                FontWeight="SemiBold"
                Foreground="#222222"
                Margin="5,15,0,10"
                Text="{DynamicResource ui-sets-title-closeWindow}" />
            <RadioButton
                Margin="8,0"
                HorizontalAlignment="Left"
                Content="{DynamicResource ui-sets-content-minToNotificationPanel}"
                GroupName="close"
                IsChecked="{Binding IsMinimizeWhenClosed, Mode=TwoWay}" />
            <RadioButton
                Margin="8,0"
                HorizontalAlignment="Left"
                Content="{DynamicResource ui-sets-content-exitProgram}"
                GroupName="close"
                IsChecked="{Binding IsExitWhenClosed, Mode=TwoWay}" />
            <CheckBox
                Margin="8,10"
                HorizontalAlignment="Left"
                Content="{DynamicResource ui-sets-content-setAsDefaultOptions}"
                IsChecked="{Binding SetAsDefaultOptions, Mode=TwoWay}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
