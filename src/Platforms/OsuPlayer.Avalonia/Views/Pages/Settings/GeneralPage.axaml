<UserControl
    x:Class="OsuPlayer.Views.Pages.Settings.GeneralPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lang="clr-namespace:OsuPlayer.Lang"
    xmlns:vm="clr-namespace:OsuPlayer.ViewModels.Pages.Settings"
    Classes="settings-page"
    x:DataType="vm:GeneralPageViewModel">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10" Spacing="6">
            <TextBlock Classes="config-title" Text="{I18N {x:Static lang:SRKeys.Ui_Sets_Title_Startup}}" />
            <CheckBox
                Classes="config-check"
                HorizontalAlignment="Left"
                Content="{I18N {x:Static lang:SRKeys.Ui_Sets_Content_RunOnStartup}}"
                IsChecked="{Binding RunOnStartup, Mode=TwoWay}" />

            <TextBlock Classes="config-title" Text="{I18N {x:Static lang:SRKeys.Ui_Sets_Title_OsuDbLocation}}" />
            <StackPanel Classes="config-row" Orientation="Horizontal">
                <TextBox
                    Classes="config-box"
                    Width="250"
                    Height="27"
                    IsReadOnly="True"
                    Text="{Binding DbPath, Mode=OneWay}" />
                <Button
                    Classes="settings-button"
                    Width="27"
                    Height="27"
                    Command="{Binding BrowseDbCommand}"
                    IsEnabled="{Binding ScannerViewModel.IsScanning, Converter={StaticResource NegativeBooleanConverter}}">
                    <Viewbox Width="12" Height="12">
                        <Path Fill="#303030" Data="M2,3H6L7.2,4.5H12.5V12.5H2Z M3.2,5.5V11.3H11.3V5.5Z" />
                    </Viewbox>
                </Button>
                <Button
                    Classes="settings-button"
                    Command="{Binding SyncNowCommand}"
                    Content="{I18N {x:Static lang:SRKeys.Ui_Btn_SyncManually}}"
                    IsEnabled="{Binding ScannerViewModel.IsScanning, Converter={StaticResource NegativeBooleanConverter}}" />
            </StackPanel>

            <TextBlock Classes="config-title" Text="{I18N {x:Static lang:SRKeys.Ui_Sets_Title_CustomSongPath}}" />
            <StackPanel Classes="config-row" Orientation="Horizontal">
                <TextBox
                    Classes="config-box"
                    Width="250"
                    Height="27"
                    IsReadOnly="True"
                    Text="{Binding CustomSongsPath, Mode=OneWay}" />
                <Button
                    Classes="settings-button"
                    Width="27"
                    Height="27"
                    Command="{Binding BrowseCustomCommand}"
                    IsEnabled="{Binding ScannerViewModel.IsScanning, Converter={StaticResource NegativeBooleanConverter}}">
                    <Viewbox Width="12" Height="12">
                        <Path Fill="#303030" Data="M2,3H6L7.2,4.5H12.5V12.5H2Z M3.2,5.5V11.3H11.3V5.5Z" />
                    </Viewbox>
                </Button>
                <Button
                    Classes="settings-button"
                    Command="{Binding ScanNowCommand}"
                    Content="{I18N {x:Static lang:SRKeys.Ui_Btn_ScanManually}}"
                    IsVisible="{Binding ScannerViewModel.IsScanning, Converter={StaticResource BoolFalseToVisibleConverter}}" />
                <ProgressBar
                    Width="60"
                    Height="4"
                    IsIndeterminate="True"
                    IsVisible="{Binding ScannerViewModel.IsScanning, Converter={StaticResource BoolTrueToVisibleConverter}}" />
                <TextBlock
                    Classes="config-label"
                    VerticalAlignment="Center"
                    IsVisible="{Binding ScannerViewModel.IsScanning, Converter={StaticResource BoolTrueToVisibleConverter}}"
                    Text="{I18N {x:Static lang:SRKeys.Ui_Sets_Content_Scanning3Dot}}" />
                <Button
                    Classes="link-button"
                    Command="{Binding CancelScanCommand}"
                    Content="{I18N {x:Static lang:SRKeys.Ui_Btn_CancelScan}}"
                    IsVisible="{Binding ScannerViewModel.IsScanning, Converter={StaticResource BoolTrueToVisibleConverter}}" />
            </StackPanel>

            <TextBlock Classes="config-title" Text="{I18N {x:Static lang:SRKeys.Ui_Sets_Title_CloseWindow}}" />
            <RadioButton
                Classes="config-radio"
                HorizontalAlignment="Left"
                Content="{I18N {x:Static lang:SRKeys.Ui_Sets_Content_MinToNotificationPanel}}"
                GroupName="close"
                IsChecked="{Binding IsMinimizeWhenClosed, Mode=TwoWay}" />
            <RadioButton
                Classes="config-radio"
                HorizontalAlignment="Left"
                Content="{I18N {x:Static lang:SRKeys.Ui_Sets_Content_ExitProgram}}"
                GroupName="close"
                IsChecked="{Binding IsExitWhenClosed, Mode=TwoWay}" />
            <CheckBox
                Classes="config-check"
                Margin="8,10,0,0"
                HorizontalAlignment="Left"
                Content="{I18N {x:Static lang:SRKeys.Ui_Sets_Content_SetAsDefaultOptions}}"
                IsChecked="{Binding SetAsDefaultOptions, Mode=TwoWay}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
