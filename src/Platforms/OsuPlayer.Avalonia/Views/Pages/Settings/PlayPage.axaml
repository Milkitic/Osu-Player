<UserControl
    x:Class="OsuPlayer.Views.Pages.Settings.PlayPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:OsuPlayer.Converters"
    xmlns:lang="clr-namespace:OsuPlayer.Lang"
    xmlns:vm="clr-namespace:OsuPlayer.ViewModels.Pages.Settings"
    x:DataType="vm:PlayPageViewModel"
    Classes="settings-page">
    <UserControl.Resources>
        <converters:DeviceInfoToStringConverter x:Key="DeviceInfoToStringConverter" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10">
            <TextBlock Classes="config-title" Text="{I18N {x:Static lang:SRKeys.Ui_Sets_Title_GlobalHitsoundDelay}}" />
            <StackPanel Classes="config-row" Orientation="Horizontal">
                <Slider
                    Width="300"
                    Margin="0,-10"
                    Classes="osu-slider"
                    Maximum="200"
                    Minimum="-200"
                    Value="{Binding GeneralOffset, Mode=TwoWay}" />
                <TextBox
                    Width="48"
                    VerticalAlignment="Center"
                    Classes="config-box"
                    Text="{Binding GeneralOffset, Mode=TwoWay}" />
            </StackPanel>

            <TextBlock Classes="config-title" Text="{I18N {x:Static lang:SRKeys.Ui_Sets_Title_AutoPlay}}" />
            <CheckBox
                HorizontalAlignment="Left"
                Classes="config-check"
                Content="{I18N {x:Static lang:SRKeys.Ui_Sets_Content_AutoPlayOnProgramStartup}}"
                IsChecked="{Binding AutoPlay, Mode=TwoWay}" />

            <TextBlock Classes="config-title" Text="{I18N {x:Static lang:SRKeys.Ui_Sets_Title_PlayProgress}}" />
            <CheckBox
                HorizontalAlignment="Left"
                Classes="config-check"
                Content="{I18N {x:Static lang:SRKeys.Ui_Sets_Content_ResumePlaylistOnProgramStartup}}"
                IsChecked="{Binding Memory, Mode=TwoWay}" />

            <TextBlock Classes="config-title" Text="{I18N {x:Static lang:SRKeys.Ui_Sets_Title_AudioPlayDevice}}" />
            <ComboBox
                Width="320"
                HorizontalAlignment="Left"
                Classes="config-box"
                ItemsSource="{Binding AvailableDevices}"
                SelectedItem="{Binding SelectedDevice, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource DeviceInfoToStringConverter}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
