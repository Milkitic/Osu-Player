<UserControl
    x:Class="OsuPlayer.Views.Pages.Settings.PlayPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:OsuPlayer.ViewModels.Pages.Settings"
    x:DataType="vm:PlayPageViewModel">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10" Spacing="6">
            <TextBlock
                FontWeight="SemiBold"
                Foreground="#222222"
                Margin="5,15,0,10"
                Text="{DynamicResource ui-sets-title-globalHitsoundDelay}" />
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Slider
                    Width="300"
                    Margin="8,0"
                    Classes="osu-slider"
                    Maximum="200"
                    Minimum="-200"
                    Value="{Binding GeneralOffset, Mode=TwoWay}" />
                <TextBox Width="35" Text="{Binding GeneralOffset, Mode=TwoWay}" />
            </StackPanel>

            <TextBlock
                FontWeight="SemiBold"
                Foreground="#222222"
                Margin="5,15,0,10"
                Text="{DynamicResource ui-sets-title-autoPlay}" />
            <CheckBox
                Margin="8,0"
                HorizontalAlignment="Left"
                Content="{DynamicResource ui-sets-content-autoPlayOnProgramStartup}"
                IsChecked="{Binding AutoPlay, Mode=TwoWay}" />

            <TextBlock
                FontWeight="SemiBold"
                Foreground="#222222"
                Margin="5,15,0,10"
                Text="{DynamicResource ui-sets-title-playProgress}" />
            <CheckBox
                Margin="8,0"
                HorizontalAlignment="Left"
                Content="{DynamicResource ui-sets-content-resumePlaylistOnProgramStartup}"
                IsChecked="{Binding Memory, Mode=TwoWay}" />

            <TextBlock
                FontWeight="SemiBold"
                Foreground="#222222"
                Margin="5,15,0,10"
                Text="{DynamicResource ui-sets-title-audioPlayDevice}" />
            <ComboBox
                Width="320"
                Margin="8,0"
                HorizontalAlignment="Left"
                ItemsSource="{Binding AvailableDevices}"
                SelectedItem="{Binding SelectedDevice, Mode=TwoWay}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
