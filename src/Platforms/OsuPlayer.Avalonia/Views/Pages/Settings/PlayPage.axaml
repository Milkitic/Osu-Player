<UserControl
    x:Class="OsuPlayer.Views.Pages.Settings.PlayPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:OsuPlayer.ViewModels.Pages.Settings"
    x:DataType="vm:PlayPageViewModel">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10" Spacing="6">
            <TextBlock
                FontSize="14"
                FontWeight="Bold"
                Foreground="White"
                Text="Global Hitsound Delay" />
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Slider
                    Width="300"
                    Margin="8,0"
                    Classes="osu-slider"
                    Maximum="200"
                    Minimum="-200"
                    Value="{Binding GeneralOffset, Mode=TwoWay}" />
                <TextBox Width="35" Text="{Binding GeneralOffset, Mode=TwoWay}" />
            </StackPanel>

            <TextBlock
                FontSize="14"
                FontWeight="Bold"
                Foreground="White"
                Text="Auto Play" />
            <CheckBox
                Margin="8,0"
                HorizontalAlignment="Left"
                Content="Auto play on program startup"
                IsChecked="{Binding AutoPlay, Mode=TwoWay}" />

            <TextBlock
                FontSize="14"
                FontWeight="Bold"
                Foreground="White"
                Text="Play Progress" />
            <CheckBox
                Margin="8,0"
                HorizontalAlignment="Left"
                Content="Resume playlist on program startup"
                IsChecked="{Binding Memory, Mode=TwoWay}" />

            <TextBlock
                FontSize="14"
                FontWeight="Bold"
                Foreground="White"
                Text="Audio Play Device" />
            <ComboBox
                Width="320"
                Margin="8,0"
                HorizontalAlignment="Left"
                ItemsSource="{Binding AvailableDevices}"
                SelectedItem="{Binding SelectedDevice, Mode=TwoWay}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
