<UserControl
    x:Class="OsuPlayer.Views.Pages.Settings.HotKeyPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lang="clr-namespace:OsuPlayer.Lang"
    xmlns:vm="clr-namespace:OsuPlayer.ViewModels.Pages.Settings"
    x:DataType="vm:HotKeyPageViewModel"
    Classes="settings-page">
    <UserControl.Styles>
        <Style Selector="TextBox.hotkey-box">
            <Setter Property="Width" Value="150" />
            <Setter Property="MinHeight" Value="27" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#B0B0B0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style Selector="TextBox.hotkey-box:focus">
            <Setter Property="BorderBrush" Value="#5D9CEC" />
            <Setter Property="Background" Value="#F7FBFF" />
        </Style>
        <Style Selector="Border.hotkey-frame">
            <Setter Property="Padding" Value="2" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.hotkey-frame.editing">
            <Setter Property="Background" Value="#EAF4FF" />
        </Style>
    </UserControl.Styles>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10" Spacing="6">
            <TextBlock Classes="config-title" Text="{I18N {x:Static lang:SRKeys.Ui_Sets_Title_HotKeySettings}}" />
            <ItemsControl ItemsSource="{Binding Entries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:HotKeyEntry">
                        <Grid Classes="config-grid" ColumnDefinitions="150,*">
                            <TextBlock
                                Grid.Column="0"
                                Classes="config-label"
                                Text="{Binding DisplayName}" />
                            <Border Grid.Column="1" Classes="hotkey-frame">
                                <TextBox
                                    Classes="hotkey-box"
                                    GotFocus="TextBox_GotFocus"
                                    KeyDown="TextBox_KeyDown"
                                    LostFocus="TextBox_LostFocus"
                                    Tag="{Binding Type}"
                                    Text="{Binding HotKeyText, Mode=TwoWay}" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
