<UserControl
    x:Class="OsuPlayer.Views.Pages.Settings.HotKeyPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:OsuPlayer.ViewModels.Pages.Settings"
    x:DataType="vm:HotKeyPageViewModel">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10" Spacing="6">
            <TextBlock
                FontSize="14"
                FontWeight="Bold"
                Foreground="White"
                Text="HotKey Settings" />
            <ItemsControl ItemsSource="{Binding Entries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:HotKeyEntry">
                        <Grid ColumnDefinitions="*,2*">
                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Foreground="White"
                                Text="{Binding DisplayName}" />
                            <TextBox
                                Grid.Column="1"
                                Width="150"
                                IsReadOnly="True"
                                Text="{Binding HotKeyText, Mode=OneWay}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
