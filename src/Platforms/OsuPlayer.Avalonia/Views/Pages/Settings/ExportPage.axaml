<UserControl
    x:Class="OsuPlayer.Views.Pages.Settings.ExportPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="using:OsuPlayer.Shared.Models"
    xmlns:vm="clr-namespace:OsuPlayer.ViewModels.Pages.Settings"
    x:DataType="vm:ExportPageViewModel">
    <UserControl.Resources>
        <vm:ExportNamingToBoolConverter x:Key="ExportNamingConv" />
        <vm:ExportGroupToBoolConverter x:Key="ExportGroupConv" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10" Spacing="6">
            <TextBlock
                FontWeight="SemiBold"
                Foreground="#222222"
                Margin="5,15,0,10"
                Text="{DynamicResource ui-sets-title-exportPath}" />
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="#606060"
                    Text="{DynamicResource ui-sets-content-musicDirectory}" />
                <TextBox
                    Width="250"
                    Height="27"
                    IsReadOnly="True"
                    Text="{Binding MusicPath, Mode=OneWay}" />
                <Button
                    Width="27"
                    Height="27"
                    Classes="style-collection"
                    Command="{Binding BrowseMusicCommand}"
                    Content="..." />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="#606060"
                    Text="{DynamicResource ui-sets-content-bgDirectory}" />
                <TextBox
                    Width="250"
                    Height="27"
                    IsReadOnly="True"
                    Text="{Binding BgPath, Mode=OneWay}" />
                <Button
                    Width="27"
                    Height="27"
                    Classes="style-collection"
                    Command="{Binding BrowseBgCommand}"
                    Content="..." />
            </StackPanel>

            <TextBlock
                FontWeight="SemiBold"
                Foreground="#222222"
                Margin="5,15,0,10"
                Text="{DynamicResource ui-sets-title-fileNamingFormat}" />
            <RadioButton
                Margin="8,0"
                Content="Title"
                GroupName="naming"
                IsChecked="{Binding NamingStyle, Converter={StaticResource ExportNamingConv}, ConverterParameter={x:Static shared:ExportNamingStyle.Title}, Mode=TwoWay}" />
            <RadioButton
                Margin="8,0"
                Content="Artist - Title"
                GroupName="naming"
                IsChecked="{Binding NamingStyle, Converter={StaticResource ExportNamingConv}, ConverterParameter={x:Static shared:ExportNamingStyle.ArtistTitle}, Mode=TwoWay}" />
            <RadioButton
                Margin="8,0"
                Content="Title - Artist"
                GroupName="naming"
                IsChecked="{Binding NamingStyle, Converter={StaticResource ExportNamingConv}, ConverterParameter={x:Static shared:ExportNamingStyle.TitleArtist}, Mode=TwoWay}" />

            <TextBlock
                FontWeight="SemiBold"
                Foreground="#222222"
                Margin="5,15,0,10"
                Text="{DynamicResource ui-sets-title-directoryGrouping}" />
            <RadioButton
                Margin="8,0"
                Content="{DynamicResource ui-sets-content-dirNoGroup}"
                GroupName="grouping"
                IsChecked="{Binding GroupStyle, Converter={StaticResource ExportGroupConv}, ConverterParameter={x:Static shared:ExportGroupStyle.None}, Mode=TwoWay}" />
            <RadioButton
                Margin="8,0"
                Content="{DynamicResource ui-sets-content-dirGroupByArtist}"
                GroupName="grouping"
                IsChecked="{Binding GroupStyle, Converter={StaticResource ExportGroupConv}, ConverterParameter={x:Static shared:ExportGroupStyle.Artist}, Mode=TwoWay}" />
            <RadioButton
                Margin="8,0"
                Content="{DynamicResource ui-sets-content-dirGroupByMapper}"
                GroupName="grouping"
                IsChecked="{Binding GroupStyle, Converter={StaticResource ExportGroupConv}, ConverterParameter={x:Static shared:ExportGroupStyle.Mapper}, Mode=TwoWay}" />
            <RadioButton
                Margin="8,0"
                Content="{DynamicResource ui-sets-content-dirGroupBySource}"
                GroupName="grouping"
                IsChecked="{Binding GroupStyle, Converter={StaticResource ExportGroupConv}, ConverterParameter={x:Static shared:ExportGroupStyle.Source}, Mode=TwoWay}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
