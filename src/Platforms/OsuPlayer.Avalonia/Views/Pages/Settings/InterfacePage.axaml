<UserControl
    x:Class="OsuPlayer.Views.Pages.Settings.InterfacePage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:OsuPlayer.ViewModels.Pages.Settings"
    x:DataType="vm:InterfacePageViewModel">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10" Spacing="6">
            <TextBlock
                FontWeight="SemiBold"
                Foreground="#222222"
                Margin="5,15,0,10"
                Text="{DynamicResource ui-sets-title-language}" />
            <ComboBox
                Width="220"
                Margin="8,0"
                HorizontalAlignment="Left"
                ItemsSource="{Binding AvailableLanguages}"
                SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}" />

            <TextBlock
                FontWeight="SemiBold"
                Foreground="#222222"
                Margin="5,15,0,10"
                Text="{DynamicResource ui-sets-title-minimalEffectMode}" />
            <CheckBox
                Margin="8,0"
                HorizontalAlignment="Left"
                Content="{DynamicResource ui-sets-title-minimalEffectMode}"
                IsChecked="{Binding MinimalMode, Mode=TwoWay}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
