<UserControl
    x:Class="OsuPlayer.Views.Pages.Settings.InterfacePage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:OsuPlayer.ViewModels.Pages.Settings"
    x:DataType="vm:InterfacePageViewModel">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10" Spacing="6">
            <TextBlock
                FontSize="14"
                FontWeight="Bold"
                Foreground="White"
                Text="Language" />
            <ComboBox
                Width="220"
                Margin="8,0"
                HorizontalAlignment="Left"
                ItemsSource="{Binding AvailableLanguages}"
                SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}" />

            <TextBlock
                FontSize="14"
                FontWeight="Bold"
                Foreground="White"
                Text="Minimal Effect Mode" />
            <CheckBox
                Margin="8,0"
                HorizontalAlignment="Left"
                Content="Enable minimal effect mode"
                IsChecked="{Binding MinimalMode, Mode=TwoWay}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
