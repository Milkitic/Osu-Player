<UserControl
    x:Class="OsuPlayer.Views.Pages.Settings.InterfacePage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lang="clr-namespace:OsuPlayer.Lang"
    xmlns:vm="clr-namespace:OsuPlayer.ViewModels.Pages.Settings"
    Classes="settings-page"
    x:DataType="vm:InterfacePageViewModel">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10" Spacing="6">
            <TextBlock Classes="config-title" Text="{I18N {x:Static lang:SRKeys.Ui_Sets_Title_Language}}" />
            <ComboBox
                Classes="config-box"
                Width="220"
                HorizontalAlignment="Left"
                ItemsSource="{Binding LanguageManager.AvailableLanguages}"
                SelectedItem="{Binding LanguageManager.SelectedLanguageItem, Mode=TwoWay}" />

            <TextBlock Classes="config-title" Text="{I18N {x:Static lang:SRKeys.Ui_Sets_Title_MinimalEffectMode}}" />
            <CheckBox
                Classes="config-check"
                HorizontalAlignment="Left"
                Content="{I18N {x:Static lang:SRKeys.Ui_Sets_Title_MinimalEffectMode}}"
                IsChecked="{Binding MinimalMode, Mode=TwoWay}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
