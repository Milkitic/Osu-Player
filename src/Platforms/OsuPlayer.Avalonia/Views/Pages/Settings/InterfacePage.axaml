<UserControl
    x:Class="OsuPlayer.Views.Pages.Settings.InterfacePage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:OsuPlayer.ViewModels.Pages.Settings"
    Classes="settings-page"
    x:DataType="vm:InterfacePageViewModel">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10" Spacing="6">
            <TextBlock Classes="config-title" Text="{DynamicResource ui-sets-title-language}" />
            <ComboBox
                Classes="config-box"
                Width="220"
                HorizontalAlignment="Left"
                ItemsSource="{Binding AvailableLanguages}"
                SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}" />

            <TextBlock Classes="config-title" Text="{DynamicResource ui-sets-title-minimalEffectMode}" />
            <CheckBox
                Classes="config-check"
                HorizontalAlignment="Left"
                Content="{DynamicResource ui-sets-title-minimalEffectMode}"
                IsChecked="{Binding MinimalMode, Mode=TwoWay}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
