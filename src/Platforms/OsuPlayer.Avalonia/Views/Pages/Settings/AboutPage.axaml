<UserControl
    x:Class="OsuPlayer.Views.Pages.Settings.AboutPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:OsuPlayer.ViewModels.Pages.Settings"
    Classes="settings-page"
    x:DataType="vm:AboutPageViewModel">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10" Spacing="6">
            <TextBlock Classes="config-title" Text="{DynamicResource ui-sets-title-softwareUpdate}" />

            <StackPanel Classes="config-row" Orientation="Horizontal">
                <TextBlock Classes="config-label" Text="{DynamicResource ui-sets-content-currentVersion}" />
                <TextBlock Classes="config-label-muted" Foreground="#222222" Text="{Binding CurrentVersion}" />
            </StackPanel>
            <StackPanel Classes="config-row" Orientation="Horizontal">
                <TextBlock Classes="config-label" Text="{DynamicResource ui-sets-content-lastCheckTime}" />
                <TextBlock Classes="config-label-muted" Foreground="#222222" Text="{Binding LastUpdateCheckText}" />
            </StackPanel>

            <StackPanel
                Margin="0,8"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    Classes="settings-button"
                    Command="{Binding CheckUpdateCommand}"
                    Content="{DynamicResource ui-sets-content-checkUpdate}" />
                <Button
                    Classes="settings-button"
                    Command="{Binding ShowNewVersionDialogCommand}"
                    Content="{DynamicResource ui-sets-content-hasNewVersion}"
                    Foreground="#FE5472"
                    IsVisible="{Binding HasUpdate}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    Classes="link-button"
                    Command="{Binding OpenUrlCommand}"
                    CommandParameter="https://github.com/Milkitic/Osu-Player"
                    Content="{DynamicResource ui-sets-content-projectUrl}" />
                <Button
                    Classes="link-button"
                    Command="{Binding OpenUrlCommand}"
                    CommandParameter="https://github.com/Milkitic/Osu-Player/issues/new"
                    Content="{DynamicResource ui-sets-content-feedback}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    Classes="link-button"
                    Command="{Binding OpenUrlCommand}"
                    CommandParameter="https://github.com/Milkitic/Osu-Player/blob/master/LICENSE"
                    Content="{DynamicResource ui-sets-content-licenseInfo}" />
                <Button
                    Classes="link-button"
                    Command="{Binding ShowPrivacyPolicyCommand}"
                    Content="{DynamicResource ui-sets-content-privacyPolicy}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
