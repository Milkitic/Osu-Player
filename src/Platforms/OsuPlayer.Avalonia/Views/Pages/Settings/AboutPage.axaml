<UserControl
    x:Class="OsuPlayer.Views.Pages.Settings.AboutPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:OsuPlayer.ViewModels.Pages.Settings"
    x:DataType="vm:AboutPageViewModel">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10" Spacing="6">
            <TextBlock
                FontWeight="SemiBold"
                Foreground="#222222"
                Margin="5,15,0,10"
                Text="{DynamicResource ui-sets-title-softwareUpdate}" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Foreground="#606060" Text="{DynamicResource ui-sets-content-currentVersion}" />
                <TextBlock Foreground="#222222" Text="{Binding CurrentVersion}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Foreground="#606060" Text="{DynamicResource ui-sets-content-lastCheckTime}" />
                <TextBlock Foreground="#222222" Text="{Binding LastUpdateCheckText}" />
            </StackPanel>

            <StackPanel
                Margin="0,8"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    Classes="style-collection"
                    Command="{Binding CheckUpdateCommand}"
                    Content="Check Update" />
                <Button
                    Classes="style-collection"
                    Command="{Binding ShowNewVersionDialogCommand}"
                    Content="{DynamicResource ui-sets-content-hasNewVersion}"
                    Foreground="#FE5472"
                    IsVisible="{Binding HasUpdate}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    Classes="style-image"
                    Command="{Binding OpenUrlCommand}"
                    CommandParameter="https://github.com/Milkitic/Osu-Player"
                    Content="{DynamicResource ui-sets-content-projectUrl}"
                    Foreground="#5472FE" />
                <Button
                    Classes="style-image"
                    Command="{Binding OpenUrlCommand}"
                    CommandParameter="https://github.com/Milkitic/Osu-Player/issues/new"
                    Content="{DynamicResource ui-sets-content-feedback}"
                    Foreground="#5472FE" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    Classes="style-image"
                    Command="{Binding OpenUrlCommand}"
                    CommandParameter="https://github.com/Milkitic/Osu-Player/blob/master/LICENSE"
                    Content="{DynamicResource ui-sets-content-licenseInfo}"
                    Foreground="#5472FE" />
                <Button
                    Classes="style-image"
                    Command="{Binding ShowPrivacyPolicyCommand}"
                    Content="{DynamicResource ui-sets-content-privacyPolicy}"
                    Foreground="#5472FE" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
