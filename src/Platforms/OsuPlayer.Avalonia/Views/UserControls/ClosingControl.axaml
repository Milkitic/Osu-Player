<UserControl
    x:Class="OsuPlayer.Views.UserControls.ClosingControl"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="10,0,10,0" Spacing="6">
        <RadioButton
            x:Name="RadioMinimum"
            HorizontalAlignment="Left"
            Content="{DynamicResource ui-sets-content-minToNotificationPanel}"
            GroupName="ClosingAction"
            IsChecked="True" />
        <RadioButton
            x:Name="RadioExit"
            HorizontalAlignment="Left"
            Content="{DynamicResource ui-sets-content-exitProgram}"
            GroupName="ClosingAction" />
        <CheckBox
            x:Name="AsDefault"
            Margin="0,10,0,0"
            HorizontalAlignment="Left"
            Content="{DynamicResource ui-sets-content-setAsDefaultOptions}" />
    </StackPanel>
</UserControl>
