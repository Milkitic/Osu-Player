<UserControl
    x:Class="OsuPlayer.Avalonia.Views.UserControls.ClosingControl"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border
        Padding="20"
        Background="#252526"
        CornerRadius="8">
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12">
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="16"
                Foreground="White"
                Text="Are you sure you want to close?" />
            <StackPanel
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <Button Classes="style-collection" Content="Yes" />
                <Button Classes="style-collection" Content="No" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
