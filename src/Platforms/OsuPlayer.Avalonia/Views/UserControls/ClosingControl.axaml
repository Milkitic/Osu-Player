<UserControl
    x:Class="OsuPlayer.Views.UserControls.ClosingControl"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lang="clr-namespace:OsuPlayer.Lang">
    <StackPanel Margin="10,5,10,0">
        <RadioButton
            x:Name="RadioMinimum"
            HorizontalAlignment="Left"
            Content="{I18N {x:Static lang:SRKeys.Ui_Sets_Content_MinToNotificationPanel}}"
            GroupName="ClosingAction"
            IsChecked="True" />
        <RadioButton
            x:Name="RadioExit"
            HorizontalAlignment="Left"
            Content="{I18N {x:Static lang:SRKeys.Ui_Sets_Content_ExitProgram}}"
            GroupName="ClosingAction" />
        <CheckBox
            x:Name="AsDefault"
            Margin="0,10,0,0"
            HorizontalAlignment="Left"
            Content="{I18N {x:Static lang:SRKeys.Ui_Sets_Content_SetAsDefaultOptions}}" />
    </StackPanel>
</UserControl>
