<UserControl
    x:Class="OsuPlayer.Views.UserControls.DiffSelectControl"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border
        Padding="16"
        Background="#252526"
        CornerRadius="8">
        <StackPanel Spacing="8">
            <TextBlock
                FontWeight="Bold"
                Foreground="White"
                Text="Select difficulty" />
            <ListBox Background="Transparent">
                <ListBoxItem>
                    <TextBlock Foreground="White" Text="Easy ★ 2.5" />
                </ListBoxItem>
                <ListBoxItem>
                    <TextBlock Foreground="White" Text="Normal ★ 4.0" />
                </ListBoxItem>
                <ListBoxItem>
                    <TextBlock Foreground="White" Text="Hard ★ 5.5" />
                </ListBoxItem>
            </ListBox>
        </StackPanel>
    </Border>
</UserControl>
