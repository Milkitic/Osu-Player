<UserControl
    x:Class="OsuPlayer.Views.UserControls.PlayController"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:userControls="clr-namespace:OsuPlayer.Views.UserControls"
    xmlns:controls="clr-namespace:OsuPlayer.Controls"
    x:DataType="userControls:PlayControllerVm">
    <UserControl.DataContext>
        <userControls:PlayControllerVm />
    </UserControl.DataContext>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://OsuPlayer/Styles/ConverterDictionary.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="controls|CommonButton.transport">
            <Setter Property="Background" Value="{DynamicResource TextureBrush}" />
            <Setter Property="BorderBrush" Value="White" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="MouseOverBackground">
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0" Color="#F05090" />
                    <GradientStop Offset="1" Color="#E05888" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="MouseDownBackground">
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0" Color="#E04070" />
                    <GradientStop Offset="1" Color="#F05090" />
                </LinearGradientBrush>
            </Setter>
        </Style>
        <Style Selector="controls|CommonButton.transport-accent">
            <Setter Property="Background" Value="#5D9CEC" />
            <Setter Property="BorderBrush" Value="#5D9CEC" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="MouseOverBackground" Value="#5D9CEC" />
            <Setter Property="MouseDownBackground" Value="#4D8CDC" />
        </Style>
        <Style Selector="controls|CommonButton.chromeless">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="MouseOverBackground" Value="#20FFFFFF" />
            <Setter Property="MouseDownBackground" Value="#30FFFFFF" />
        </Style>
        <Style Selector="controls|CommonButton.title-link">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="#777777" />
            <Setter Property="MouseOverBackground" Value="Transparent" />
            <Setter Property="MouseDownBackground" Value="Transparent" />
        </Style>
    </UserControl.Styles>
    <Grid Background="#2D2D30">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid ColumnDefinitions="Auto,Auto,*,Auto">
            <Button
                x:Name="ThumbButton"
                Grid.Column="0"
                Width="61"
                Height="46"
                Margin="1"
                Click="ThumbButton_Click">
                <Image
                    Width="61"
                    Height="46"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Source="{Binding ThumbSource}"
                    Stretch="UniformToFill" />
            </Button>
            <StackPanel
                Grid.Column="1"
                Margin="10,0,10,0"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <controls:CommonButton
                    Classes="transport"
                    Width="28"
                    Height="28"
                    Margin="8"
                    Command="{Binding PrevCommand}"
                    IconSize="0"
                    CornerRadius="7">
                    <Viewbox Width="14" Height="14">
                        <Path Fill="White" Data="M2,2H4V12H2ZM5,7L12,12V2Z" />
                    </Viewbox>
                </controls:CommonButton>
                <controls:CommonButton
                    Classes="transport"
                    Width="32"
                    Height="32"
                    Margin="8"
                    Command="{Binding PlayCommand}"
                    IconSize="0"
                    CornerRadius="16">
                    <controls:CommonButton.Content>
                        <MultiBinding Converter="{StaticResource PlayingConverter}">
                            <Binding Path="Shared.IsPlaying" />
                        </MultiBinding>
                    </controls:CommonButton.Content>
                </controls:CommonButton>
                <controls:CommonButton
                    Classes="transport"
                    Width="28"
                    Height="28"
                    Margin="8"
                    Command="{Binding NextCommand}"
                    IconSize="0"
                    CornerRadius="7">
                    <Viewbox Width="14" Height="14">
                        <Path Fill="White" Data="M10,2H12V12H10ZM2,2V12L9,7Z" />
                    </Viewbox>
                </controls:CommonButton>
                <controls:CommonButton
                    Classes="transport-accent"
                    Width="28"
                    Height="28"
                    Margin="8"
                    Command="{Binding OpenCommand}"
                    CornerRadius="14"
                    IconSize="0"
                    >
                    <Viewbox Width="14" Height="14">
                        <Path Fill="White" Data="M6,2H8V6H12V8H8V12H6V8H2V6H6Z" />
                    </Viewbox>
                </controls:CommonButton>
            </StackPanel>
            <Grid Grid.Column="2" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,1,0,-3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <controls:CommonButton
                        Classes="title-link"
                        Grid.Column="0"
                        Margin="3,0"
                        Padding="0"
                        Click="TitleArtist_Click"
                        IconSize="0">
                        <TextBlock>
                            <Run Foreground="#777777" Text="{Binding Controller.PlayList.CurrentInfo.BeatmapDetail.Metadata.TitleAuto, Mode=OneWay}" />
                            <Run Text=" - " />
                            <Run Foreground="#AAAAAA" Text="{Binding Controller.PlayList.CurrentInfo.BeatmapDetail.Metadata.ArtistAuto, Mode=OneWay}" />
                        </TextBlock>
                    </controls:CommonButton>
                    <controls:CommonButton
                        Classes="title-link"
                        x:Name="BtnAsio"
                        Grid.Column="1"
                        Height="20"
                        FontSize="11"
                        Margin="3,0"
                        Padding="4,0"
                        HorizontalAlignment="Right"
                        Command="{Binding AsioCommand}"
                        IconSize="0"
                        Content="ASIO"
                        IsVisible="{Binding AsioVisible}" />
                    <StackPanel
                        x:Name="LblProgress"
                        Grid.Column="2"
                        Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Foreground="#777" Text="{Binding CurrentTimeText}" />
                        <TextBlock
                            Margin="-5,0,-5,0"
                            VerticalAlignment="Center"
                            Foreground="#858585"
                            Text="/" />
                        <TextBlock VerticalAlignment="Center" Foreground="#AAA" Text="{Binding TotalTimeText}" />
                    </StackPanel>
                </Grid>
                <Slider
                    x:Name="PlayProgress"
                    Grid.Row="1"
                    Classes="osu-slider"
                    Margin="3"
                    Maximum="{Binding TotalTimeMs}"
                    Minimum="0"
                    Value="{Binding CurrentTimeMs}" />
            </Grid>
            <Grid Grid.Column="3">
                <StackPanel
                    Margin="10,0,10,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <controls:CommonButton
                        Classes="chromeless"
                        x:Name="ModeButton"
                        Width="24"
                        Height="24"
                        FontSize="16"
                        Margin="8"
                        Click="ModeButton_Click"
                        IconMargin="0"
                        IconSize="0"
                        Content="{Binding Controller.PlayList.Mode, Converter={StaticResource PlayModeConverter}}" />
                    <controls:CommonButton
                        Classes="chromeless"
                        Width="23"
                        Height="23"
                        FontSize="16"
                        Margin="6"
                        VerticalAlignment="Center"
                        Click="LikeButton_Click"
                        IconMargin="0"
                        IconSize="0"
                        Content="{Binding Controller.PlayList.CurrentInfo.BeatmapDetail.Metadata.IsFavorite, Converter={StaticResource BoolIsFavToSvgConverter}}" />
                    <controls:CommonButton
                        Classes="chromeless"
                        x:Name="VolumeButton"
                        Width="23"
                        Height="23"
                        Margin="6"
                        VerticalAlignment="Center"
                        Click="VolumeButton_Click"
                        IconMargin="0"
                        IconSize="0">
                        <Viewbox Width="16" Height="16">
                            <Path Fill="White" Data="M2,6H5L8,3V13L5,10H2Z M10,5A4,4 0 0 1 10,11 M11.5,3.5A6,6 0 0 1 11.5,12.5" />
                        </Viewbox>
                    </controls:CommonButton>
                    <controls:CommonButton
                        Classes="chromeless"
                        x:Name="PlayListButton"
                        Width="23"
                        Height="23"
                        Margin="6"
                        VerticalAlignment="Center"
                        Click="PlayListButton_Click"
                        IconMargin="0"
                        IconSize="0">
                        <Viewbox Width="16" Height="16">
                            <Path Fill="White" Data="M3,4H13V5.5H3ZM3,7.25H13V8.75H3ZM3,10.5H13V12H3Z" />
                        </Viewbox>
                    </controls:CommonButton>
                </StackPanel>
            </Grid>
        </Grid>
        <Popup
            x:Name="PopMode"
            Width="110"
            HorizontalOffset="-44"
            IsLightDismissEnabled="True"
            Placement="Top"
            PlacementTarget="{Binding ElementName=ModeButton}">
            <userControls:PlayModeControl />
        </Popup>
        <Popup
            x:Name="PopPlayList"
            Width="600"
            Height="500"
            HorizontalOffset="-570"
            IsLightDismissEnabled="True"
            Placement="Top"
            PlacementTarget="{Binding ElementName=PlayListButton}">
            <userControls:PlayListControl CloseRequested="PlayListControl_CloseRequested" />
        </Popup>
        <Popup
            x:Name="Pop"
            MinWidth="170"
            IsLightDismissEnabled="True"
            Placement="Top"
            PlacementTarget="{Binding ElementName=VolumeButton}">
            <userControls:VolumeControl />
        </Popup>
    </Grid>
</UserControl>
