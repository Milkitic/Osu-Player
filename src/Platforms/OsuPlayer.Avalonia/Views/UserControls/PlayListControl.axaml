<UserControl
    x:Class="OsuPlayer.Avalonia.Views.UserControls.PlayListControl"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Padding="8" Background="#252526">
        <DockPanel>
            <StackPanel
                Margin="0,0,0,8"
                DockPanel.Dock="Top"
                Orientation="Horizontal"
                Spacing="6">
                <Button Classes="style-collection" Content="Play All" />
                <Button Classes="style-collection" Content="Clear" />
                <Button Classes="style-collection" Content="Save" />
            </StackPanel>
            <ListBox Background="Transparent">
                <ListBoxItem>
                    <StackPanel>
                        <TextBlock Foreground="White" Text="Sample Track 1" />
                        <TextBlock
                            FontSize="11"
                            Foreground="#AAAAAA"
                            Text="Artist" />
                    </StackPanel>
                </ListBoxItem>
            </ListBox>
        </DockPanel>
    </Border>
</UserControl>
