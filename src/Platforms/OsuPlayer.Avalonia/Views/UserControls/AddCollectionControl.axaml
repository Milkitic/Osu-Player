<UserControl
    x:Class="OsuPlayer.Views.UserControls.AddCollectionControl"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="10" Spacing="6">
        <TextBlock
            FontWeight="Bold"
            Foreground="White"
            Text="New collection name" />
        <TextBox PlaceholderText="Collection name" />
        <StackPanel
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="6">
            <Button Classes="style-collection" Content="Cancel" />
            <Button Classes="style-collection" Content="Create" />
        </StackPanel>
    </StackPanel>
</UserControl>
