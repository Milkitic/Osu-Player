<UserControl
    x:Class="OsuPlayer.Views.UserControls.AddCollectionControl"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:OsuPlayer.Controls">
    <Grid>
        <controls:CommonTextBox
            x:Name="CollectionName"
            Width="260"
            Height="40"
            Margin="5,10,5,0"
            Padding="3"
            VerticalAlignment="Top"
            FontSize="15"
            Hint="{DynamicResource ui-max30Char}"
            MaxLength="30"
            TextWrapping="Wrap" />
    </Grid>
</UserControl>
