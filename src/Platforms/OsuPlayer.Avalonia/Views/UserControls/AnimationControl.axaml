<UserControl
    x:Class="OsuPlayer.Views.UserControls.AnimationControl"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:userControls="clr-namespace:OsuPlayer.Views.UserControls"
    x:DataType="userControls:AnimationControlVm">
    <Border
        BorderBrush="#40FFFFFF"
        BorderThickness="1"
        ClipToBounds="True">
        <Grid>
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0" Color="#DC498D" />
                    <GradientStop Offset="1" Color="White" />
                </LinearGradientBrush>
            </Grid.Background>

            <Border Background="Black">
                <Image
                    x:Name="BackImage"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    RenderOptions.BitmapInterpolationMode="HighQuality"
                    Source="{Binding BackgroundSource}"
                    Stretch="UniformToFill" />
            </Border>
        </Grid>
    </Border>
</UserControl>
