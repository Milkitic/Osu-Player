<UserControl
    x:Class="OsuPlayer.Views.UserControls.DifficultyBadge"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:gamePlay="clr-namespace:Coosu.Beatmap.Sections.GamePlay;assembly=Coosu.Beatmap"
    x:Name="Self"
    x:CompileBindings="False">
    <StackPanel Orientation="Horizontal">
        <Image
            Width="13"
            Height="13"
            Margin="0,0,1,0"
            Source="{Binding ElementName=Self, Path=GameMode, Converter={StaticResource GameModeToImageConverter}, ConverterParameter=circle}" />
        <Border
            Height="14"
            Margin="1,0,3,0"
            Padding="5,0"
            CornerRadius="6"
            Background="{Binding ElementName=Self, Path=StarRating, Converter={StaticResource StarRating2ColorConverter}}">
            <TextBlock
                VerticalAlignment="Center"
                FontSize="11"
                FontWeight="Bold"
                Foreground="{Binding ElementName=Self, Path=StarRating, Converter={StaticResource StarRating2ForeColorConverter}}"
                Text="{Binding ElementName=Self, Path=StarRating, Mode=OneWay, StringFormat=\{0:N2\}}" />
        </Border>
        <TextBlock
            FontSize="12"
            FontWeight="SemiBold"
            Foreground="{Binding ElementName=Self, Path=VersionForeground}"
            Text="{Binding ElementName=Self, Path=Version}"
            TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
